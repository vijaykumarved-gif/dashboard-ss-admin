<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard — Searvator CRM</title>
    <link rel="stylesheet" href="/css/main.css">
    <%- include('partials/mobile-head') %>
    <style>
        /* Order queue styles */
        .queue-row {
            display: grid;
            grid-template-columns: 1fr 1.2fr 1.6fr 0.9fr;
            gap: 16px;
            padding: 16px;
            border-bottom: 1px solid var(--border);
            align-items: start;
        }
        .queue-row:last-child { border-bottom: none; }
        .queue-row:hover { background: var(--surface-2); }
        .vendor-form { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .vendor-form input, .vendor-form select { padding: 6px 8px; font-size: 12px; }
        .vendor-form .full { grid-column: span 2; }
        .timer-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            color: var(--danger);
            font-weight: 700;
            font-size: 11px;
            margin-top: 4px;
        }
        .wa-btn {
            background: #25D366;
            color: white;
            padding: 10px 14px;
            border-radius: var(--radius);
            border: none;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            text-decoration: none;
            display: block;
            text-align: center;
            transition: all 0.2s var(--ease);
        }
        .wa-btn:hover { background: #128C7E; transform: translateY(-1px); }
        .inline-form { display: inline-flex; gap: 4px; align-items: center; }
        .inline-form input { width: 60px; padding: 4px 6px; font-size: 12px; text-align: center; }
        .inline-form select { padding: 4px 6px; font-size: 11px; }
        .inline-form button {
            background: var(--accent);
            color: white;
            border: none;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
        }
        .photo-modal {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.85);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 200;
            padding: 20px;
        }
        .photo-modal.open { display: flex; }
        .photo-modal img { max-width: 90vw; max-height: 85vh; border-radius: 8px; }
        .photo-modal-close {
            position: absolute; top: 20px; right: 20px;
            background: white; color: var(--danger);
            width: 40px; height: 40px;
            border-radius: 50%; border: none;
            font-size: 22px; cursor: pointer; font-weight: bold;
        }
        .alert-card {
            background: linear-gradient(135deg, #fef3c7 0%, #fed7aa 100%);
            border: 1px solid #fcd34d;
            border-radius: var(--radius-md);
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .alert-icon { font-size: 24px; }
        @media (max-width: 1100px) {
            .queue-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<div class="app-layout">
    <%- include('partials/sidebar', { user: user, activePage: 'hardware' }) %>
    
    <main class="main-content">
        <div class="page-header">
            <div>
                <h1 class="page-title">Hardware & Repair</h1>
                <p class="page-subtitle">Service operations, vendor pricing, agent dispatch & follow-ups</p>
            </div>
            <div style="display: flex; gap: 8px;">
                <button onclick="findDuplicates()" class="btn btn-secondary">🧹 Find Duplicates</button>
                <a href="/admin/export?agent=<%= query.agent || '' %>&date=<%= query.date || '' %>" class="btn btn-success">
                    ⬇️ Download Excel
                </a>
            </div>
        </div>
        
        <!-- ===== KPI STATS ===== -->
        <div class="stats-grid">
            <div class="stat-card amber">
                <div class="stat-label">Follow-up Impact</div>
                <div class="stat-value" style="color: var(--warning)">₹<%= followUpRevenue %></div>
                <div class="stat-meta">Converted lead revenue</div>
            </div>
            <div class="stat-card blue">
                <div class="stat-label">Today's Revenue</div>
                <div class="stat-value">₹<%= todayRevenue %></div>
                <div class="stat-meta">Target: ₹<%= targets.dailyTarget %></div>
            </div>
            <div class="stat-card purple">
                <div class="stat-label">Weekly</div>
                <div class="stat-value" style="color: var(--purple)">₹<%= weekRevenue %></div>
                <div class="stat-meta">Target: ₹<%= targets.weeklyTarget %></div>
            </div>
            <div class="stat-card green">
                <div class="stat-label">Monthly</div>
                <div class="stat-value" style="color: var(--success)">₹<%= monthRevenue %></div>
                <div class="stat-meta">Target: ₹<%= targets.monthlyTarget %></div>
            </div>
        </div>
        
        <!-- ===== TOTALS BAR ===== -->
        <div style="background: var(--accent); border-radius: var(--radius-md); padding: 20px; margin-bottom: 24px; display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; text-align: center; color: white;">
            <div>
                <div style="font-size: 11px; opacity: 0.7; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Gross Revenue</div>
                <div style="font-size: 22px; font-weight: 800; color: #4ade80; margin-top: 4px;" class="font-mono">₹<%= (totalRevenue || 0).toLocaleString('en-IN') %></div>
            </div>
            <div>
                <div style="font-size: 11px; opacity: 0.7; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Collected</div>
                <div style="font-size: 22px; font-weight: 800; color: #34d399; margin-top: 4px;" class="font-mono">₹<%= (typeof totalCollected !== 'undefined' ? totalCollected : 0).toLocaleString('en-IN') %></div>
            </div>
            <div>
                <div style="font-size: 11px; opacity: 0.7; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Pending Due</div>
                <div style="font-size: 22px; font-weight: 800; color: #fbbf24; margin-top: 4px;" class="font-mono">₹<%= (typeof totalPendingDue !== 'undefined' ? totalPendingDue : 0).toLocaleString('en-IN') %></div>
            </div>
            <div>
                <div style="font-size: 11px; opacity: 0.7; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Total Travel Cost</div>
                <div style="font-size: 22px; font-weight: 800; color: #f87171; margin-top: 4px;" class="font-mono">₹<%= (totalExpense || 0).toLocaleString('en-IN') %></div>
            </div>
            <div>
                <div style="font-size: 11px; opacity: 0.7; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Net Profit</div>
                <div style="font-size: 22px; font-weight: 800; color: #60a5fa; margin-top: 4px;" class="font-mono">₹<%= ((totalRevenue || 0) - (totalExpense || 0)).toLocaleString('en-IN') %></div>
            </div>
        </div>
        
        <!-- ===== ALERT (Weak Point) ===== -->
        <div class="alert-card" style="margin-bottom: 24px;">
            <div class="alert-icon">⚠️</div>
            <div>
                <div style="font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: #92400e; margin-bottom: 4px;">Area Improvement Analysis</div>
                <div style="font-weight: 600; color: #78350f;"><%= weakPoint %></div>
            </div>
        </div>
        
        <!-- ===== PART & SERVICE QUEUE ===== -->
        <div class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">📦 Part & Service Requests Queue</div>
                    <div class="card-subtitle">Vendor pricing & assign to agent</div>
                </div>
                <span class="badge warning"><%= orders.length %> total</span>
            </div>
            
            <% if (orders.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-icon">📦</div>
                    <div class="empty-title">No requests yet</div>
                    <div>Agent ke part requests yahan dikhenge</div>
                </div>
            <% } else { %>
                <!-- Header row -->
                <div class="queue-row" style="background: var(--surface-2); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-2);">
                    <div>Customer & Timer</div>
                    <div>Requirement</div>
                    <div>Vendor Pricing & Assign</div>
                    <div>Status / Action</div>
                </div>
                
                <% 
                // SMART: detect duplicate requests (same mobile + same requirement)
                const seenReq = new Set();
                orders.forEach(order => { 
                    const dupKey = ((order.mobileNumber || '') + '|' + (order.description || '')).toLowerCase();
                    const isDup = seenReq.has(dupKey);
                    seenReq.add(dupKey);
                %>
                <div class="queue-row" style="<%= isDup ? 'background:#fff7ed; border-left:3px solid #f97316;' : '' %>">
                    <!-- Customer -->
                    <div>
                        <div class="font-bold"><%= order.customerName %></div>
                        <div class="text-muted" style="font-size: 11px;"><%= order.mobileNumber %></div>
                        <div class="timer-badge">⏳ <span class="live-timer" data-time="<%= order.createdAt.toISOString() %>"></span></div>
                        <% if (isDup) { %><span class="badge warning" style="margin-top:4px; display:inline-block; font-size:9px;">⚠️ Duplicate request</span><% } %>
                    </div>
                    
                    <!-- Requirement -->
                    <div>
                        <div style="font-weight: 600; color: var(--primary); font-size: 12px;"><%= order.description %></div>
                        <div class="text-muted" style="font-size: 11px; margin-top: 2px;">Req by: <%= order.createdBy %></div>
                        <% if (order.requestPhoto) { %>
                            <button onclick="openPhotoModal('<%= order.requestPhoto %>')" class="btn btn-xs btn-secondary" style="margin-top: 6px;">📷 View Photo</button>
                        <% } %>
                    </div>
                    
                    <!-- Vendor pricing form -->
                    <div>
                        <form action="/api/admin/order/process/<%= order._id %>" method="POST" class="vendor-form">
                            <input type="text" name="vendorName" value="<%= order.vendorName %>" placeholder="Vendor Name" required>
                            <input type="text" name="warranty" value="<%= order.warranty %>" placeholder="Warranty">
                            <input type="number" name="costPrice" value="<%= order.costPrice %>" placeholder="Cost ₹" style="color: var(--danger); font-weight: 700;" required>
                            <input type="number" name="sellingPrice" value="<%= order.sellingPrice %>" placeholder="Selling ₹" style="color: var(--success); font-weight: 700;" required>
                            <select name="assignedAgent" class="full">
                                <option value="vijay" <%= order.assignedAgent === 'vijay' ? 'selected' : '' %>>Assign: Vijay</option>
                                <option value="rahul" <%= order.assignedAgent === 'rahul' ? 'selected' : '' %>>Assign: Rahul</option>
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm full" style="background: var(--warning); color: white;">Save & Send to Agent</button>
                        </form>
                    </div>
                    
                    <!-- Status / Action -->
                    <div>
                        <% 
                        const sc = order.status === 'Completed' ? 'success' : order.status === 'In Progress' ? 'info' : 'warning';
                        %>
                        <span class="badge <%= sc %>" style="display: inline-block; margin-bottom: 8px;"><%= order.status %></span>
                        <% if (order.status !== 'Completed') { %>
                            <button onclick="deleteOrder('<%= order._id %>', '<%= (order.customerName || '').replace(/'/g, '') %>')" class="btn btn-xs btn-danger" style="display:block; margin-bottom:6px;">🗑️ Remove</button>
                        <% } %>
                        
                        <% if (order.status === 'Completed') { %>
                            <div style="margin-top: 6px;">
                                <% if (order.whatsappSent) { %>
                                    <span class="badge success" style="display: block; margin-bottom: 6px;">✓ WA SENT</span>
                                <% } else { %>
                                    <span class="badge danger" style="display: block; margin-bottom: 6px;">❌ WA PENDING</span>
                                <% } %>
                                <a href="/order-invoice/<%= order._id %>" target="_blank" class="btn btn-xs" style="background: var(--purple); color: white; display: inline-block;">📄 Invoice</a>
                            </div>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            <% } %>
        </div>
        
        <!-- ===== ROW: TARGETS + DISPATCH ===== -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
            <!-- TARGETS -->
            <div class="card" style="margin-bottom: 0;">
                <div class="card-header">
                    <div class="card-title">🎯 Set Revenue Targets</div>
                </div>
                <div class="card-body">
                    <form action="/api/admin/targets" method="POST">
                        <div class="form-group mb-2">
                            <label class="form-label">Daily (₹)</label>
                            <input type="number" name="dailyTarget" value="<%= targets.dailyTarget %>" style="color: var(--primary); font-weight: 700; text-align: right;">
                        </div>
                        <div class="form-group mb-2">
                            <label class="form-label">Weekly (₹)</label>
                            <input type="number" name="weeklyTarget" value="<%= targets.weeklyTarget %>" style="color: var(--purple); font-weight: 700; text-align: right;">
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label">Monthly (₹)</label>
                            <input type="number" name="monthlyTarget" value="<%= targets.monthlyTarget %>" style="color: var(--success); font-weight: 700; text-align: right;">
                        </div>
                        <button type="submit" class="btn btn-primary w-full">Update Targets</button>
                    </form>
                </div>
            </div>
            
            <!-- DISPATCH & WHATSAPP BULK -->
            <div class="card" style="margin-bottom: 0;">
                <div class="card-header">
                    <div class="card-title">➕ Dispatch New Lead</div>
                </div>
                <div class="card-body">
                    <form action="/api/admin/assign" method="POST">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                            <input type="text" name="customerName" placeholder="Customer Name" required>
                            <input type="tel" name="mobileNumber" placeholder="Mobile" required>
                        </div>
                        <input type="text" name="location" placeholder="Address / Location" required style="margin-bottom: 8px;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <select name="agentName" required>
                                <option value="">Select Agent...</option>
                                <option value="vijay">Vijay</option>
                                <option value="rahul">Rahul</option>
                            </select>
                            <button type="submit" class="btn btn-primary">Assign Lead</button>
                        </div>
                    </form>
                    
                    <% 
                    let msgVijay = "Hello Vijay, aaj ke pending tasks:\n\n";
                    pendingVijay.forEach(e => msgVijay += `📌 *${e.customerName}*\n📞 ${e.mobileNumber}\n📍 ${e.location}\n\n`);
                    let msgRahul = "Hello Rahul, aaj ke pending tasks:\n\n";
                    pendingRahul.forEach(e => msgRahul += `📌 *${e.customerName}*\n📞 ${e.mobileNumber}\n📍 ${e.location}\n\n`);
                    %>
                    
                    <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border);">
                        <div class="form-label mb-2">📲 Bulk Dispatch Pending</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(msgVijay) %>" target="_blank" class="wa-btn">
                                Send <%= pendingVijay.length %> to Vijay
                            </a>
                            <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(msgRahul) %>" target="_blank" class="wa-btn">
                                Send <%= pendingRahul.length %> to Rahul
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- ===== LOG FILTERS ===== -->
        <div class="card">
            <div class="card-header">
                <div class="card-title">🔍 Logs & Report Filters</div>
            </div>
            <div class="card-body">
                <form method="GET" action="/admin" style="display: grid; grid-template-columns: 1fr 1fr auto auto; gap: 12px; align-items: end;">
                    <div class="form-group">
                        <label class="form-label">Agent</label>
                        <select name="agent">
                            <option value="">All</option>
                            <option value="vijay" <%= query.agent === 'vijay' ? 'selected' : '' %>>Vijay</option>
                            <option value="rahul" <%= query.agent === 'rahul' ? 'selected' : '' %>>Rahul</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Specific Date</label>
                        <input type="date" name="date" value="<%= query.date %>">
                    </div>
                    <button type="submit" class="btn btn-primary">Apply</button>
                    <a href="/admin" class="btn btn-secondary">Reset</a>
                </form>
            </div>
        </div>
        
        <!-- ===== DETAILED OPERATIONS LEDGER ===== -->
        <div class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">📋 Detailed Operations Ledger</div>
                    <div class="card-subtitle"><%= entries.length %> entries</div>
                </div>
            </div>
            <div class="card-body" style="padding-bottom: 0;">
                <!-- Search + quick filters -->
                <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 12px;">
                    <div style="display: flex; gap: 4px;" id="ledgerDateBtns">
                        <button type="button" class="btn btn-xs btn-primary" data-range="today" onclick="setLedgerRange('today', this)">📅 Today</button>
                        <button type="button" class="btn btn-xs btn-secondary" data-range="7d" onclick="setLedgerRange('7d', this)">7 Days</button>
                        <button type="button" class="btn btn-xs btn-secondary" data-range="all" onclick="setLedgerRange('all', this)">All</button>
                    </div>
                    <input type="text" id="ledgerSearch" placeholder="🔍 Search customer / mobile / location..." 
                        style="flex: 1; min-width: 220px; padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px; font-size: 13px;"
                        oninput="filterLedger()">
                    <select id="ledgerStatusFilter" onchange="filterLedger()" style="padding: 8px; border: 1px solid var(--border); border-radius: 8px; font-size: 13px;">
                        <option value="">All Status</option>
                        <option value="pending">Pending only</option>
                        <option value="completed">Completed only</option>
                        <option value="wapending">WA Pending</option>
                    </select>
                    <span id="ledgerCount" style="font-size: 12px; color: var(--text-3);"></span>
                </div>
            </div>
            <div class="table-wrap">
                <table class="data-table" id="ledgerTable">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Customer / Agent</th>
                            <th>Status / Revenue</th>
                            <th>Travel Cost</th>
                            <th>Follow-up</th>
                            <th class="text-center">Report / Invoice</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% 
                        const tDate = new Date().toISOString().split('T')[0];
                        if (entries.length === 0) { %>
                            <tr><td colspan="6" class="text-center" style="padding: 40px; color: var(--text-3);">No entries match these filters</td></tr>
                        <% } else { entries.forEach(function(entry) {
                            const followDateStr = entry.followUpDate ? entry.followUpDate.toISOString().split('T')[0] : null;
                            const isToday = followDateStr === tDate && entry.callStatus !== 'Done';
                            const isPending = entry.jobStatus === 'Assigned';
                            const isWaPending = !entry.whatsappSent && entry.jobStatus !== 'Assigned';
                            const searchStr = ((entry.customerName || '') + ' ' + (entry.mobileNumber || '') + ' ' + (entry.location || '')).toLowerCase();
                        %>
                        <tr class="ledger-row" 
                            data-search="<%= searchStr %>" 
                            data-status="<%= isPending ? 'pending' : 'completed' %>"
                            data-wa="<%= isWaPending ? 'wapending' : '' %>"
                            data-date="<%= entry.createdAt.toISOString().split('T')[0] %>">
                            <td>
                                <div class="font-bold"><%= entry.createdAt.toLocaleDateString() %></div>
                                <div class="text-muted" style="font-size: 11px;">🕒 <%= entry.createdAt.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></div>
                                <div style="margin-top: 6px;">
                                    <% if (entry.whatsappSent) { %>
                                        <span class="badge success">✓ WA SENT</span>
                                    <% } else if (entry.jobStatus !== 'Assigned') { %>
                                        <span class="badge danger">❌ WA PENDING</span>
                                    <% } %>
                                </div>
                            </td>
                            
                            <td>
                                <div class="font-bold"><%= entry.customerName %></div>
                                <div class="text-muted" style="font-size: 11px;"><%= entry.mobileNumber %> · <%= entry.location %></div>
                                <div style="font-size: 10px; font-weight: 700; color: var(--primary); text-transform: uppercase; margin-top: 3px;">Logged by: <%= entry.agentName %></div>
                            </td>
                            
                            <td>
                                <% if (entry.jobStatus === 'Assigned') { %>
                                    <span class="badge warning">Pending</span>
                                <% } else { 
                                    const rev = entry.revenue || 0;
                                    const recd = entry._recd !== undefined ? entry._recd : rev;
                                    const due = entry._due !== undefined ? entry._due : 0;
                                %>
                                    <div class="font-mono font-bold" style="font-size: 13px;">₹<%= rev.toLocaleString('en-IN') %></div>
                                    <% if (due > 0) { %>
                                        <div style="font-size: 10px; color: var(--success);">Recd: ₹<%= recd.toLocaleString('en-IN') %></div>
                                        <div style="font-size: 11px; color: var(--danger); font-weight: 700;">Due: ₹<%= due.toLocaleString('en-IN') %></div>
                                    <% } else { %>
                                        <span class="badge success" style="font-size: 9px;">✓ Paid</span>
                                    <% } %>
                                    <button class="btn btn-xs <%= due > 0 ? 'btn-success' : 'btn-secondary' %>" style="margin-top: 4px;"
                                        onclick="openHwPay('<%= entry._id %>', '<%= (entry.customerName || '').replace(/'/g, '') %>', <%= rev %>, <%= recd %>)">💰 Payment</button>
                                <% } %>
                            </td>
                            
                            <td>
                                <form action="/api/admin/update-km/<%= entry._id %>" method="POST" class="inline-form">
                                    <input type="number" name="kmTraveled" value="<%= entry.kmTraveled %>" placeholder="KM">
                                    <button type="submit">Save</button>
                                </form>
                                <% if (entry.travelExpense > 0) { %>
                                    <div class="text-muted" style="font-size: 10px; margin-top: 4px;">₹<%= entry.travelExpense.toFixed(0) %></div>
                                <% } %>
                            </td>
                            
                            <td>
                                <% if (entry.followUpDate) { %>
                                    <div style="font-size: 11px; font-weight: 700; color: <%= isToday ? 'var(--danger)' : 'var(--text-2)' %>;">
                                        Call: <%= entry.followUpDate.toLocaleDateString() %>
                                    </div>
                                    <% if (entry.callStatus !== 'Done') { %>
                                        <form action="/api/admin/followup/<%= entry._id %>" method="POST" class="inline-form" style="margin-top: 4px;">
                                            <select name="conversionStatus">
                                                <option value="Converted">Converted</option>
                                                <option value="Not Interested">Not Interested</option>
                                            </select>
                                            <button type="submit" style="background: var(--primary);">Done</button>
                                        </form>
                                    <% } else { %>
                                        <div style="font-size: 10px; font-weight: 700; color: var(--success); margin-top: 4px;">✓ Done (<%= entry.conversionStatus %>)</div>
                                    <% } %>
                                <% } else { %>
                                    <span class="text-muted" style="font-size: 11px;">No Lead</span>
                                <% } %>
                            </td>
                            
                            <td class="text-center">
                                <% if (entry.jobStatus !== 'Assigned') { %>
                                    <div style="display: flex; flex-direction: column; gap: 4px;">
                                        <a href="/invoice/<%= entry._id %>" target="_blank" class="btn btn-xs" style="background: var(--purple-light); color: #6d28d9; border: 1px solid #ddd6fe;">🧾 Invoice</a>
                                        <a href="/report/<%= entry._id %>" target="_blank" class="btn btn-xs" style="background: var(--info-light); color: var(--primary); border: 1px solid #bfdbfe;">🛠️ Report</a>
                                    </div>
                                <% } %>
                            </td>
                        </tr>
                        <% }) } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<script>
    // === LEDGER DATE RANGE (default: Today, smart fallback to All) ===
    let ledgerRange = 'today';
    function setLedgerRange(range, btn) {
        ledgerRange = range;
        document.querySelectorAll('#ledgerDateBtns button').forEach(b => { b.classList.remove('btn-primary'); b.classList.add('btn-secondary'); });
        if (btn) { btn.classList.remove('btn-secondary'); btn.classList.add('btn-primary'); }
        filterLedger();
    }
    function dateMatches(dateStr) {
        if (ledgerRange === 'all' || !dateStr) return true;
        const today = new Date(); today.setHours(0,0,0,0);
        const d = new Date(dateStr + 'T00:00:00');
        if (ledgerRange === 'today') return d.getTime() === today.getTime();
        if (ledgerRange === '7d') { const wk = new Date(today); wk.setDate(wk.getDate() - 7); return d >= wk; }
        return true;
    }
    function filterLedger() {
        const q = (document.getElementById('ledgerSearch').value || '').toLowerCase().trim();
        const statusF = document.getElementById('ledgerStatusFilter').value;
        const rows = document.querySelectorAll('.ledger-row');
        let visible = 0;
        rows.forEach(row => {
            const matchSearch = !q || (row.dataset.search || '').includes(q);
            const matchDate = dateMatches(row.dataset.date);
            let matchStatus = true;
            if (statusF === 'pending') matchStatus = row.dataset.status === 'pending';
            else if (statusF === 'completed') matchStatus = row.dataset.status === 'completed';
            else if (statusF === 'wapending') matchStatus = row.dataset.wa === 'wapending';
            const show = matchSearch && matchStatus && matchDate;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        const countEl = document.getElementById('ledgerCount');
        if (countEl) {
            const label = ledgerRange === 'today' ? 'today' : ledgerRange === '7d' ? 'last 7 days' : 'all';
            countEl.textContent = visible + ' shown (' + label + ')';
        }
        return visible;
    }
    // init: default Today; agar aaj koi entry nahi to smart fallback to All
    document.addEventListener('DOMContentLoaded', () => {
        const shown = filterLedger();
        if (shown === 0 && ledgerRange === 'today') {
            const allBtn = document.querySelector('#ledgerDateBtns button[data-range="all"]');
            setLedgerRange('all', allBtn);
        }
    });

    // === HARDWARE PAYMENT ===
    let hpId = null, hpTotal = 0;
    function openHwPay(id, name, total, recd) {
        hpId = id; hpTotal = total;
        document.getElementById('hp_name').textContent = name || '-';
        document.getElementById('hp_total').textContent = '₹' + total.toLocaleString('en-IN');
        document.getElementById('hp_recd').textContent = '₹' + recd.toLocaleString('en-IN');
        document.getElementById('hp_due').textContent = '₹' + Math.max(0, total - recd).toLocaleString('en-IN');
        document.getElementById('hp_amount').value = recd;
        document.getElementById('hp_error').style.display = 'none';
        openModal('hwPayModal');
        validateHwPay();
    }
    function hwPayFull() { document.getElementById('hp_amount').value = hpTotal; validateHwPay(); }
    function hwPayNone() { document.getElementById('hp_amount').value = 0; validateHwPay(); }
    function validateHwPay() {
        const amt = Number(document.getElementById('hp_amount').value);
        const err = document.getElementById('hp_error'), btn = document.getElementById('hp_submit'), pv = document.getElementById('hp_preview');
        if (isNaN(amt) || amt < 0) { err.textContent = '⚠️ Valid amount daalo'; err.style.display = 'block'; btn.disabled = true; pv.textContent = ''; return false; }
        if (amt > hpTotal) {
            err.textContent = `⚠️ Job value se zyada nahi (₹${hpTotal.toLocaleString('en-IN')})`;
            err.style.display = 'block'; btn.disabled = true; pv.textContent = ''; return false;
        }
        err.style.display = 'none'; btn.disabled = false;
        const due = hpTotal - amt;
        pv.innerHTML = due > 0
            ? `<span style="color:#dc2626;">Baaki due rahega: ₹${due.toLocaleString('en-IN')}</span>`
            : `<span style="color:#16a34a;">✓ Fully paid</span>`;
        return true;
    }
    async function submitHwPay() {
        if (!validateHwPay()) return;
        const body = {
            amountReceived: Number(document.getElementById('hp_amount').value),
            mode: document.getElementById('hp_mode').value
        };
        try {
            const res = await fetch('/api/admin/entry-payment/' + hpId, {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
            });
            const data = await res.json();
            if (data.success) { showToast('✓ Payment updated', 'success'); setTimeout(() => location.reload(), 700); }
            else showToast(data.error || 'Failed', 'error');
        } catch (e) { showToast('Error: ' + e.message, 'error'); }
    }

    // === DELETE PART/SERVICE REQUEST ===
    async function deleteOrder(id, name) {
        if (!confirm('"' + name + '" ki ye request remove karni hai?')) return;
        try {
            const res = await fetch('/api/order/delete/' + id, { method: 'POST' });
            const data = await res.json();
            if (data.success) { showToast('✓ Request removed', 'success'); setTimeout(() => location.reload(), 600); }
            else showToast(data.error || 'Failed', 'error');
        } catch (e) { showToast('Error: ' + e.message, 'error'); }
    }

    // === DUPLICATE CLEANUP ===
    async function findDuplicates() {
        openModal('dupModal');
        document.getElementById('dupBody').innerHTML = '<div style="text-align:center; padding:30px; color:var(--text-3);">🔍 Scanning for duplicates...</div>';
        document.getElementById('dupSummary').textContent = 'Scanning...';
        document.getElementById('dupDeleteBtn').style.display = 'none';
        try {
            const res = await fetch('/api/admin/duplicates');
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Failed');
            
            if (data.groups.length === 0) {
                document.getElementById('dupSummary').textContent = 'All clean!';
                document.getElementById('dupBody').innerHTML = '<div style="text-align:center; padding:40px;"><div style="font-size:40px;">✅</div><div style="font-weight:700; margin-top:8px;">No duplicates found!</div><div style="color:var(--text-3); font-size:13px;">Har customer ki entries unique hain.</div></div>';
                return;
            }
            
            document.getElementById('dupSummary').textContent = `${data.groups.length} customers with duplicates · ${data.totalDuplicates} extra entries`;
            document.getElementById('dupDeleteBtn').style.display = 'inline-flex';
            
            let html = '<div style="font-size:12px; color:var(--text-3); margin-bottom:12px;">💡 Har group me sabse latest/best entry KEEP karo (checkbox unchecked), baaki duplicates SELECT karke delete karo. WA SENT aur revenue wali entries usually keep karni chahiye.</div>';
            
            data.groups.forEach(g => {
                html += `<div style="border:1px solid var(--border); border-radius:10px; padding:12px; margin-bottom:12px;">`;
                html += `<div style="font-weight:700; margin-bottom:8px;">👤 ${g.customerName} <span style="color:var(--text-3); font-weight:400; font-size:12px;">· ${g.mobile} · ${g.count} entries</span></div>`;
                
                g.entries.forEach((e, i) => {
                    const d = new Date(e.date);
                    const dateStr = d.toLocaleDateString('en-IN') + ' ' + d.toLocaleTimeString('en-IN', {hour:'2-digit', minute:'2-digit'});
                    const statusBadge = e.status === 'Completed' ? `<span style="color:#16a34a;">₹${e.revenue||0}</span>` : '<span style="color:#d97706;">Pending</span>';
                    const waBadge = e.waSent ? '✓ WA' : '';
                    // First one (latest) suggested to keep - unchecked; rest checked for deletion
                    const checked = i === 0 ? '' : 'checked';
                    html += `
                        <label style="display:flex; align-items:center; gap:10px; padding:8px; border-radius:6px; background:${i===0?'#f0fdf4':'#fef2f2'}; margin-bottom:6px; cursor:pointer;">
                            <input type="checkbox" class="dup-check" value="${e.id}" ${checked}>
                            <div style="flex:1; font-size:12px;">
                                <div>${dateStr} ${i===0?'<strong style="color:#16a34a;">(latest - keep)</strong>':''}</div>
                                <div style="color:var(--text-3);">${e.location||'-'} · ${statusBadge} · ${waBadge} · ${e.agent||''}</div>
                            </div>
                        </label>`;
                });
                html += `</div>`;
            });
            
            document.getElementById('dupBody').innerHTML = html;
        } catch (e) {
            document.getElementById('dupBody').innerHTML = `<div style="text-align:center; padding:30px; color:var(--danger);">Error: ${e.message}</div>`;
        }
    }
    
    async function deleteDuplicates() {
        const checked = Array.from(document.querySelectorAll('.dup-check:checked')).map(c => c.value);
        if (checked.length === 0) {
            showToast('Koi entry select nahi ki', 'error');
            return;
        }
        if (!confirm(`${checked.length} duplicate entries delete karni hain? Ye permanent hai.`)) return;
        try {
            const res = await fetch('/api/admin/duplicates/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: checked })
            });
            const data = await res.json();
            if (data.success) {
                showToast(`✓ ${data.deleted} duplicates deleted`, 'success');
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast(data.error || 'Failed', 'error');
            }
        } catch (e) {
            showToast('Error: ' + e.message, 'error');
        }
    }
</script>

<!-- Photo Modal -->
<div class="photo-modal" id="photoModal">
    <button class="photo-modal-close" onclick="closePhotoModal()">×</button>
    <img id="photoModalImg" src="" alt="">
</div>

<!-- Duplicate Cleanup Modal -->
<div class="modal-overlay" id="dupModal">
    <div class="modal" style="max-width: 720px; max-height: 85vh; overflow-y: auto;">
        <div class="modal-header">
            <div>
                <div class="modal-title">🧹 Duplicate Entries Cleanup</div>
                <div class="card-subtitle" id="dupSummary">Scanning...</div>
            </div>
            <button class="modal-close" onclick="closeModal('dupModal')">×</button>
        </div>
        <div class="modal-body" id="dupBody">
            <div style="text-align: center; padding: 30px; color: var(--text-3);">Loading...</div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('dupModal')">Close</button>
            <button class="btn btn-danger" id="dupDeleteBtn" onclick="deleteDuplicates()" style="display:none;">🗑️ Delete Selected</button>
        </div>
    </div>
</div>

<!-- Hardware Payment Modal -->
<div class="modal-overlay" id="hwPayModal">
    <div class="modal" style="max-width: 420px;">
        <div class="modal-header">
            <div class="modal-title">💰 Add Payment</div>
            <button class="modal-close" onclick="closeModal('hwPayModal')">×</button>
        </div>
        <div class="modal-body">
            <div style="background: #f0fdf4; border-radius: 8px; padding: 12px; margin-bottom: 14px;">
                <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:4px;">
                    <span style="color: var(--text-3);">Customer:</span><span class="font-bold" id="hp_name">-</span>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:4px;">
                    <span style="color: var(--text-3);">Total:</span><span class="font-mono" id="hp_total">-</span>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:4px;">
                    <span style="color: var(--text-3);">Already Received:</span><span class="font-mono" style="color:#16a34a;" id="hp_recd">-</span>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:14px; font-weight:700; padding-top:6px; border-top:1px solid #bbf7d0;">
                    <span>Balance Due:</span><span class="font-mono" style="color:#dc2626;" id="hp_due">-</span>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Total Amount Received (₹) *</label>
                <input type="number" id="hp_amount" placeholder="0" style="font-size:18px; font-weight:700;" oninput="validateHwPay()">
                <div style="font-size:11px; color:var(--text-3); margin-top:4px;">Customer ne ab tak kul kitna diya — poora ya aadha</div>
                <div id="hp_error" style="color:#dc2626; font-size:12px; margin-top:4px; display:none;"></div>
                <div id="hp_preview" style="font-size:12px; margin-top:6px; font-weight:700;"></div>
            </div>
            <div class="form-group">
                <label class="form-label">Payment Mode</label>
                <select id="hp_mode">
                    <option>Cash</option><option>UPI</option><option>Bank Transfer</option><option>Card</option><option>Cheque</option>
                </select>
            </div>
            <div style="display:flex; gap:6px;">
                <button class="btn btn-xs btn-secondary" type="button" onclick="hwPayFull()">Full Paid</button>
                <button class="btn btn-xs btn-secondary" type="button" onclick="hwPayNone()">Nothing Received</button>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('hwPayModal')">Cancel</button>
            <button class="btn btn-success" id="hp_submit" onclick="submitHwPay()">Record Payment</button>
        </div>
    </div>
</div>

<script src="/js/common.js"></script>
<script>
    function openPhotoModal(src) {
        document.getElementById('photoModalImg').src = src;
        document.getElementById('photoModal').classList.add('open');
    }
    function closePhotoModal() {
        document.getElementById('photoModal').classList.remove('open');
    }
    document.getElementById('photoModal').addEventListener('click', (e) => {
        if (e.target.id === 'photoModal') closePhotoModal();
    });
    
    function updateTimers() {
        document.querySelectorAll('.live-timer').forEach(el => {
            const startTime = new Date(el.dataset.time).getTime();
            const now = new Date().getTime();
            const diff = now - startTime;
            const hours = Math.floor(diff / (1000 * 60 * 60));
            const days = Math.floor(hours / 24);
            const displayHours = hours % 24;
            el.innerText = days > 0 ? `${days}d ${displayHours}h` : `${hours}h ${Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))}m`;
        });
    }
    setInterval(updateTimers, 60000);
    updateTimers();
</script>
</body>
</html>
