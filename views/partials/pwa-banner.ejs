<!-- PWA install banner -->
<div class="pwa-install-banner" id="pwaInstall">
    <div>
        <div style="font-weight: 700; font-size: 14px;">📲 Install Searvator App</div>
        <div style="font-size: 11px; opacity: 0.8; margin-top: 2px;">Fast access from your home screen</div>
    </div>
    <div style="display: flex; gap: 6px;">
        <button onclick="pwaDismiss()" style="background: transparent; color: white; border: 1px solid rgba(255,255,255,0.3); padding: 6px 10px; border-radius: 8px; font-size: 12px;">Later</button>
        <button onclick="pwaInstall()" class="btn btn-sm">Install</button>
    </div>
</div>
