<!-- Mobile bottom navigation -->
<nav class="mobile-bottom-nav">
    <a href="/agent" class="<%= typeof activeNav !== 'undefined' && activeNav === 'home' ? 'active' : '' %>">
        <span class="nav-icon-bottom">🏠</span>
        <span>Home</span>
    </a>
    <a href="/agent/leads" class="<%= typeof activeNav !== 'undefined' && activeNav === 'leads' ? 'active' : '' %>" style="position: relative;">
        <span class="nav-icon-bottom">🎯</span>
        <span>Leads</span>
        <span id="leadsBottomBadge" style="display:none; position: absolute; top: 2px; right: 18%; background: var(--danger); color: white; font-size: 9px; padding: 1px 5px; border-radius: 10px; font-weight: 700;"></span>
    </a>
    <a href="/agent/amc" class="<%= typeof activeNav !== 'undefined' && activeNav === 'amc' ? 'active' : '' %>">
        <span class="nav-icon-bottom">📅</span>
        <span>AMC</span>
    </a>
    <a href="/chat" class="<%= typeof activeNav !== 'undefined' && activeNav === 'chat' ? 'active' : '' %>" style="position: relative;">
        <span class="nav-icon-bottom">💬</span>
        <span>Chat</span>
        <span id="chatBottomBadge" style="display:none; position: absolute; top: 2px; right: 18%; background: var(--danger); color: white; font-size: 9px; padding: 1px 5px; border-radius: 10px; font-weight: 700;"></span>
    </a>
    <a href="/logout" style="color: var(--danger);">
        <span class="nav-icon-bottom">🚪</span>
        <span>Logout</span>
    </a>
</nav>
<script>
async function refreshBottomBadges() {
    try {
        const [chat, leads] = await Promise.all([
            fetch('/api/chat/unread-count').then(r => r.json()).catch(() => ({count: 0})),
            fetch('/api/leads/my-pending').then(r => r.json()).catch(() => ({newLeads: 0}))
        ]);
        const b1 = document.getElementById('chatBottomBadge');
        const b2 = document.getElementById('leadsBottomBadge');
        if (b1) {
            if (chat.count > 0) { b1.textContent = chat.count; b1.style.display = 'inline-block'; }
            else b1.style.display = 'none';
        }
        if (b2) {
            if (leads.newLeads > 0) { b2.textContent = leads.newLeads; b2.style.display = 'inline-block'; }
            else b2.style.display = 'none';
        }
    } catch (e) {}
}
refreshBottomBadges();
setInterval(refreshBottomBadges, 10000);
</script>
