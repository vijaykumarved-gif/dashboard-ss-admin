<!-- Photo modal -->
<div class="modal-overlay" id="photoModal">
    <div class="modal" style="background: transparent; box-shadow: none; max-width: 90vw;">
        <button class="modal-close" onclick="closeModal('photoModal')" style="position: absolute; top: 10px; right: 10px;">×</button>
        <img id="photoModalImg" style="width: 100%; border-radius: 8px;">
    </div>
</div>

<script src="/js/common.js"></script>
<script>
    const OFFICE_ID = '<%= office._id %>';
    const CONTACT_MOBILE = '<%= office.contactMobile %>';
    const OFFICE_NAME = '<%= office.officeName %>';
    
    function openPhotoModal(src) {
        document.getElementById('photoModalImg').src = src;
        document.getElementById('photoModal').classList.add('active');
    }
    
    // Photo compression
    function compressPhoto(file, hiddenId) {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = function(event) {
            const img = new Image();
            img.src = event.target.result;
            img.onload = function() {
                const canvas = document.createElement('canvas');
                const MAX_WIDTH = 800;
                canvas.width = MAX_WIDTH;
                canvas.height = img.height * (MAX_WIDTH / img.width);
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                document.getElementById(hiddenId).value = canvas.toDataURL('image/jpeg', 0.6);
            }
        }
    }
    document.getElementById('pc_beforefile').addEventListener('change', (e) => { if (e.target.files[0]) compressPhoto(e.target.files[0], 'pc_before'); });
    document.getElementById('pc_afterfile').addEventListener('change', (e) => { if (e.target.files[0]) compressPhoto(e.target.files[0], 'pc_after'); });
    
    function editPC(pc) {
        document.getElementById('pcModalTitle').textContent = 'Update PC: ' + pc.pcId;
        document.getElementById('pc_id').value = pc._id;
        document.getElementById('pc_pcid').value = pc.pcId;
        document.getElementById('pc_type').value = pc.pcType;
        document.getElementById('pc_model').value = pc.pcModel || '';
        document.getElementById('pc_user').value = pc.user || '';
        document.getElementById('pc_dept').value = pc.department || '';
        document.getElementById('pc_rate').value = pc.ratePerPC || 0;
        document.getElementById('pc_mb').value = pc.motherboard;
        document.getElementById('pc_cpu').value = pc.cpu;
        document.getElementById('pc_ram').value = pc.ramStatus;
        document.getElementById('pc_hdd').value = pc.hddHealth;
        document.getElementById('pc_fan').value = pc.fan;
        document.getElementById('pc_temp').value = pc.temperature;
        document.getElementById('pc_bat').value = pc.battery;
        document.getElementById('pc_mon').value = pc.monitor;
        document.getElementById('pc_before').value = pc.beforePhoto || '';
        document.getElementById('pc_after').value = pc.afterPhoto || '';
        document.getElementById('pc_remarks').value = pc.remarks || '';
        openModal('pcModal');
    }
    
    async function savePC() {
        const id = document.getElementById('pc_id').value;
        const data = {
            pcId: document.getElementById('pc_pcid').value,
            pcType: document.getElementById('pc_type').value,
            pcModel: document.getElementById('pc_model').value,
            user: document.getElementById('pc_user').value,
            department: document.getElementById('pc_dept').value,
            ratePerPC: Number(document.getElementById('pc_rate').value),
            motherboard: document.getElementById('pc_mb').value,
            cpu: document.getElementById('pc_cpu').value,
            ramStatus: document.getElementById('pc_ram').value,
            hddHealth: document.getElementById('pc_hdd').value,
            fan: document.getElementById('pc_fan').value,
            temperature: document.getElementById('pc_temp').value,
            battery: document.getElementById('pc_bat').value,
            monitor: document.getElementById('pc_mon').value,
            beforePhoto: document.getElementById('pc_before').value,
            afterPhoto: document.getElementById('pc_after').value,
            remarks: document.getElementById('pc_remarks').value,
            lastServicedDate: new Date()
        };
        if (!data.pcId) return showToast('PC ID required', 'error');
        const url = id ? `/api/amc/offices/${OFFICE_ID}/pcs/${id}` : `/api/amc/offices/${OFFICE_ID}/pcs`;
        const method = id ? 'PUT' : 'POST';
        const res = await api(url, { method, body: JSON.stringify(data) });
        if (res.success) { showToast('PC saved', 'success'); setTimeout(() => location.reload(), 500); }
    }
    
    async function deletePC(id) {
        if (!confirm('Delete this PC?')) return;
        const res = await api(`/api/amc/offices/${OFFICE_ID}/pcs/${id}`, { method: 'DELETE' });
        if (res.success) { showToast('Deleted', 'success'); setTimeout(() => location.reload(), 400); }
    }
    
    async function saveVisit() {
        const data = {
            visitDate: document.getElementById('v_date').value,
            visitTime: document.getElementById('v_time').value,
            assignedAgent: document.getElementById('v_agent').value,
            purpose: document.getElementById('v_purpose').value,
            notes: document.getElementById('v_notes').value
        };
        if (!data.visitDate) return showToast('Date required', 'error');
        const res = await api(`/api/amc/offices/${OFFICE_ID}/visits`, { method: 'POST', body: JSON.stringify(data) });
        if (res.success) { showToast('Visit scheduled', 'success'); setTimeout(() => location.reload(), 500); }
    }
    
    async function updateVisitStatus(vId, status) {
        const res = await api(`/api/amc/offices/${OFFICE_ID}/visits/${vId}`, { method: 'PUT', body: JSON.stringify({ status }) });
        if (res.success) showToast('Status updated', 'success');
    }
    
    async function deleteVisit(vId) {
        if (!confirm('Delete this visit?')) return;
        const res = await api(`/api/amc/offices/${OFFICE_ID}/visits/${vId}`, { method: 'DELETE' });
        if (res.success) { showToast('Deleted', 'success'); setTimeout(() => location.reload(), 400); }
    }
    
    // Send WhatsApp notification for visit
    function sendVisitWA(vId, dateStr, time, agent, purpose) {
        const adminMobile = '9106959092'; // your admin mobile
        const agentMobile = agent === 'vijay' ? '9106959092' : '9106959092'; // configure agent numbers
        
        // Message to client (office contact)
        const clientMsg = `*Visit Scheduled - Searvator IT Solutions*\n\nDear ${OFFICE_NAME},\n\nOur engineer *${agent.toUpperCase()}* will visit your office:\n\n📅 *Date:* ${dateStr}\n🕒 *Time:* ${time}\n🎯 *Purpose:* ${purpose}\n\nFor any rescheduling, please contact us.\n\nRegards,\nTeam Searvator`;
        
        // Message to agent
        const agentMsg = `*New Visit Assigned*\n\n🏢 *Office:* ${OFFICE_NAME}\n📅 *Date:* ${dateStr}\n🕒 *Time:* ${time}\n🎯 *Purpose:* ${purpose}\n📞 *Client Contact:* ${CONTACT_MOBILE}\n\nPlease confirm.\n\n- Searvator Admin`;
        
        // Mark sent in DB
        fetch(`/api/amc/offices/${OFFICE_ID}/visits/${vId}/wa-sent`, { method: 'POST' });
        
        // Open WA for client
        let clientPhone = CONTACT_MOBILE.replace(/\D/g, '');
        if (clientPhone.length === 10) clientPhone = '91' + clientPhone;
        const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
        const clientUrl = isMobile 
            ? `https://wa.me/${clientPhone}?text=${encodeURIComponent(clientMsg)}` 
            : `https://web.whatsapp.com/send?phone=${clientPhone}&text=${encodeURIComponent(clientMsg)}`;
        
        // Open both messages — client first, then agent in new tab
        window.open(clientUrl, '_blank');
        setTimeout(() => {
            let agentPhone = agentMobile.replace(/\D/g, '');
            if (agentPhone.length === 10) agentPhone = '91' + agentPhone;
            const agentUrl = isMobile 
                ? `https://wa.me/${agentPhone}?text=${encodeURIComponent(agentMsg)}` 
                : `https://web.whatsapp.com/send?phone=${agentPhone}&text=${encodeURIComponent(agentMsg)}`;
            window.open(agentUrl, '_blank');
            location.reload();
        }, 1500);
    }
    
    async function savePayment() {
        const data = {
            amount: Number(document.getElementById('p_amt').value),
            paidDate: document.getElementById('p_date').value || new Date(),
            paymentMode: document.getElementById('p_mode').value,
            invoiceNumber: document.getElementById('p_inv').value,
            notes: document.getElementById('p_notes').value
        };
        if (!data.amount) return showToast('Amount required', 'error');
        const res = await api(`/api/amc/offices/${OFFICE_ID}/payments`, { method: 'POST', body: JSON.stringify(data) });
        if (res.success) { showToast('Payment added', 'success'); setTimeout(() => location.reload(), 500); }
    }
    
    async function deletePayment(pId) {
        if (!confirm('Delete this payment?')) return;
        const res = await api(`/api/amc/offices/${OFFICE_ID}/payments/${pId}`, { method: 'DELETE' });
        if (res.success) { showToast('Deleted', 'success'); setTimeout(() => location.reload(), 400); }
    }
    
    async function saveExpense() {
        const data = {
            category: document.getElementById('e_cat').value,
            amount: Number(document.getElementById('e_amt').value),
            description: document.getElementById('e_desc').value
        };
        if (!data.amount) return showToast('Amount required', 'error');
        const res = await api(`/api/amc/offices/${OFFICE_ID}/expenses`, { method: 'POST', body: JSON.stringify(data) });
        if (res.success) { showToast('Expense added', 'success'); setTimeout(() => location.reload(), 500); }
    }
    
    async function deleteExpense(eId) {
        if (!confirm('Delete this expense?')) return;
        const res = await api(`/api/amc/offices/${OFFICE_ID}/expenses/${eId}`, { method: 'DELETE' });
        if (res.success) { showToast('Deleted', 'success'); setTimeout(() => location.reload(), 400); }
    }
    
    async function deleteOffice() {
        if (!confirm('Delete this office and ALL its data? This cannot be undone.')) return;
        const res = await api(`/api/amc/offices/${OFFICE_ID}`, { method: 'DELETE' });
        if (res.success) { showToast('Office deleted', 'success'); setTimeout(() => location.href = '/amc', 500); }
    }
    
    // Reset PC modal on close
    document.querySelector('#pcModal .modal-close').addEventListener('click', () => {
        document.getElementById('pc_id').value = '';
        document.getElementById('pcModalTitle').textContent = 'Add PC / System';
    });
</script>
</body>
</html>
