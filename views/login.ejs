<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Searvator CRM — Sign in</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --ink: #0f172a; --muted: #64748b; --line: #e2e8f0;
            --brand: #2563eb; --brand2: #7c3aed; --bg: #f6f8fc;
        }
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
            background: var(--bg); color: var(--ink); overflow: hidden; position: relative;
            padding: 20px;
        }
        /* Soft animated background shapes */
        .bg-shape { position: fixed; border-radius: 50%; filter: blur(70px); opacity: 0.35; z-index: 0; animation: drift 22s ease-in-out infinite; }
        .bg-shape.s1 { width: 380px; height: 380px; background: #bfdbfe; top: -120px; left: -80px; }
        .bg-shape.s2 { width: 320px; height: 320px; background: #ddd6fe; bottom: -100px; right: -60px; animation-delay: -8s; }
        .bg-shape.s3 { width: 240px; height: 240px; background: #bae6fd; top: 55%; left: 12%; animation-delay: -15s; }
        @keyframes drift { 0%,100% { transform: translate(0,0); } 33% { transform: translate(30px,-30px); } 66% { transform: translate(-20px,25px); } }

        .card {
            position: relative; z-index: 10; width: 100%; max-width: 420px;
            background: #ffffff; border: 1px solid var(--line); border-radius: 28px;
            padding: 38px 36px 32px; box-shadow: 0 30px 70px -20px rgba(37,99,235,0.18), 0 8px 24px rgba(15,23,42,0.05);
            animation: cardIn 0.7s cubic-bezier(0.16,1,0.3,1);
        }
        @keyframes cardIn { from { opacity:0; transform: translateY(24px) scale(0.97); } to { opacity:1; transform: none; } }

        /* Greeting */
        .greeting { display: flex; align-items: center; gap: 8px; justify-content: center; margin-bottom: 6px; }
        .greeting .emoji { font-size: 20px; animation: wave 2.5s ease-in-out infinite; transform-origin: 70% 70%; }
        @keyframes wave { 0%,60%,100% { transform: rotate(0); } 10%,30% { transform: rotate(14deg); } 20% { transform: rotate(-8deg); } }
        .greeting .text { font-size: 14px; font-weight: 600; color: var(--muted); }
        .brand-name { text-align: center; font-size: 25px; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 2px; }
        .brand-tag { text-align: center; font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 18px; }

        /* Robot */
        .robot-stage { display: flex; justify-content: center; margin-bottom: 20px; }
        .robot { width: 130px; height: 120px; }
        .robot .arm { transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1); transform-origin: center; }
        .robot.peek .arm-l { transform: translate(34px, -34px) rotate(-52deg); }
        .robot.peek .arm-r { transform: translate(-34px, -34px) rotate(52deg); }
        .robot .pupil { transition: transform 0.15s ease-out; }
        .robot .eye-lid { transform: scaleY(0); transform-origin: center; transition: transform 0.1s ease; }
        .robot.blink .eye-lid { transform: scaleY(1); }
        .robot.sad .mouth { d: path("M 52 90 Q 65 82 78 90"); }
        .robot .antenna-tip { animation: pulse 2s ease-in-out infinite; }
        @keyframes pulse { 0%,100% { opacity: 1; r: 5; } 50% { opacity: 0.5; r: 6; } }
        .robot.shake { animation: shake 0.5s ease; }
        @keyframes shake { 0%,100%{transform:translateX(0);} 20%,60%{transform:translateX(-8px);} 40%,80%{transform:translateX(8px);} }
        .robot.happy { animation: bounce 0.6s ease; }
        @keyframes bounce { 0%,100%{transform:translateY(0);} 30%{transform:translateY(-12px);} 60%{transform:translateY(-4px);} }

        /* Fields */
        .field { margin-bottom: 14px; }
        .field label { display: block; font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
        .input-wrap { position: relative; }
        .input-wrap > svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: #94a3b8; pointer-events: none; transition: color 0.2s; }
        .field input {
            width: 100%; padding: 13px 14px 13px 42px; background: #f8fafc;
            border: 1.5px solid var(--line); border-radius: 13px; color: var(--ink);
            font-size: 14px; font-family: inherit; outline: none; transition: all 0.2s;
        }
        .field input::placeholder { color: #cbd5e1; }
        .field input:focus { border-color: var(--brand); background: #fff; box-shadow: 0 0 0 4px rgba(37,99,235,0.1); }
        .field input:focus ~ svg { color: var(--brand); }
        .toggle-pw { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #94a3b8; font-size: 12px; font-weight: 600; padding: 4px; }

        .signin {
            width: 100%; padding: 14px; margin-top: 6px;
            background: linear-gradient(135deg, var(--brand), var(--brand2));
            border: none; border-radius: 13px; color: #fff; font-size: 15px; font-weight: 700;
            font-family: inherit; cursor: pointer; transition: all 0.25s; position: relative; overflow: hidden;
        }
        .signin:hover { transform: translateY(-2px); box-shadow: 0 12px 28px -8px rgba(37,99,235,0.5); }
        .signin:active { transform: translateY(0); }
        .signin::after { content:''; position:absolute; top:0; left:-100%; width:100%; height:100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent); transition: left 0.6s; }
        .signin:hover::after { left: 100%; }

        .error-box {
            display: flex; align-items: center; gap: 8px; background: #fef2f2; border: 1px solid #fecaca;
            color: #b91c1c; padding: 11px 14px; border-radius: 12px; font-size: 13px; font-weight: 500;
            margin-bottom: 16px; animation: errIn 0.4s ease;
        }
        @keyframes errIn { from { opacity:0; transform: translateY(-6px);} to { opacity:1; transform:none;} }

        .footer { text-align: center; margin-top: 22px; font-size: 11px; color: #94a3b8; line-height: 1.6; }
        .footer strong { color: var(--muted); }

        @media (max-width: 480px) { .card { padding: 30px 22px; } .brand-name { font-size: 22px; } }
        @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
    </style>
</head>
<body>
    <div class="bg-shape s1"></div>
    <div class="bg-shape s2"></div>
    <div class="bg-shape s3"></div>

    <div class="card">
        <!-- Time-based greeting -->
        <div class="greeting">
            <span class="emoji" id="greetEmoji">👋</span>
            <span class="text" id="greetText">Welcome back</span>
        </div>
        <h1 class="brand-name">Searvator CRM</h1>
        <p class="brand-tag">Search and Facilitator</p>

        <!-- Animated Robot -->
        <div class="robot-stage">
            <svg class="robot" id="robot" viewBox="0 0 130 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Antenna -->
                <line x1="65" y1="18" x2="65" y2="8" stroke="#94a3b8" stroke-width="3" stroke-linecap="round"/>
                <circle class="antenna-tip" cx="65" cy="6" r="5" fill="#7c3aed"/>
                <!-- Head -->
                <rect x="28" y="18" width="74" height="60" rx="18" fill="#eff2f7" stroke="#cbd5e1" stroke-width="2"/>
                <!-- Screen face -->
                <rect x="36" y="28" width="58" height="40" rx="12" fill="#0f172a"/>
                <!-- Eyes -->
                <g id="eyeL">
                    <circle cx="52" cy="46" r="7" fill="#38bdf8"/>
                    <circle class="pupil" id="pupilL" cx="52" cy="46" r="3" fill="#fff"/>
                    <rect class="eye-lid" x="45" y="39" width="14" height="14" rx="4" fill="#0f172a"/>
                </g>
                <g id="eyeR">
                    <circle cx="78" cy="46" r="7" fill="#38bdf8"/>
                    <circle class="pupil" id="pupilR" cx="78" cy="46" r="3" fill="#fff"/>
                    <rect class="eye-lid" x="71" y="39" width="14" height="14" rx="4" fill="#0f172a"/>
                </g>
                <!-- Mouth -->
                <path class="mouth" id="mouth" d="M 54 60 Q 65 64 76 60" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" fill="none"/>
                <!-- Body -->
                <rect x="40" y="80" width="50" height="30" rx="12" fill="#eff2f7" stroke="#cbd5e1" stroke-width="2"/>
                <circle cx="55" cy="95" r="3" fill="#cbd5e1"/>
                <circle cx="65" cy="95" r="3" fill="#cbd5e1"/>
                <circle cx="75" cy="95" r="3" fill="#cbd5e1"/>
                <!-- Arms (cover eyes on password) -->
                <g class="arm arm-l" id="armL">
                    <rect x="18" y="82" width="22" height="10" rx="5" fill="#cbd5e1"/>
                    <circle cx="18" cy="87" r="7" fill="#94a3b8"/>
                </g>
                <g class="arm arm-r" id="armR">
                    <rect x="90" y="82" width="22" height="10" rx="5" fill="#cbd5e1"/>
                    <circle cx="112" cy="87" r="7" fill="#94a3b8"/>
                </g>
            </svg>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error-box">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <form method="POST" action="/login" id="loginForm">
            <div class="field">
                <label>Username</label>
                <div class="input-wrap">
                    <input type="text" name="username" id="username" required autofocus placeholder="Enter your username" autocomplete="username">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
            </div>
            <div class="field">
                <label>Password</label>
                <div class="input-wrap">
                    <input type="password" name="password" id="password" required placeholder="Enter your password" autocomplete="current-password">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    <button type="button" class="toggle-pw" id="togglePw" tabindex="-1">SHOW</button>
                </div>
            </div>
            <button type="submit" class="signin">Sign in →</button>
        </form>

        <div class="footer">
            <strong>Searvator IT Solutions Pvt. Ltd.</strong><br>
            Secure business management portal
        </div>
    </div>

    <script>
        // ===== TIME-BASED GREETING =====
        (function() {
            const h = new Date().getHours();
            let emoji, text;
            if (h >= 5 && h < 12)       { emoji = '☀️'; text = 'Good morning'; }
            else if (h >= 12 && h < 17) { emoji = '🌤️'; text = 'Good afternoon'; }
            else if (h >= 17 && h < 21) { emoji = '🌇'; text = 'Good evening'; }
            else                        { emoji = '🌙'; text = 'Working late? Good night'; }
            document.getElementById('greetEmoji').textContent = emoji;
            document.getElementById('greetText').textContent = text;
        })();

        // ===== ROBOT INTERACTIONS =====
        const robot = document.getElementById('robot');
        const username = document.getElementById('username');
        const password = document.getElementById('password');
        const pupilL = document.getElementById('pupilL');
        const pupilR = document.getElementById('pupilR');

        // Eyes follow username typing (move pupils right as you type)
        username.addEventListener('input', () => {
            const len = Math.min(username.value.length, 12);
            const offset = (len / 12) * 4 - 2; // -2 to +2
            pupilL.setAttribute('cx', 52 + offset);
            pupilR.setAttribute('cx', 78 + offset);
        });

        // Cover eyes when password focused / has content
        function coverEyes() { robot.classList.add('peek'); }
        function uncoverEyes() { if (document.activeElement !== password) robot.classList.remove('peek'); }
        password.addEventListener('focus', coverEyes);
        password.addEventListener('blur', uncoverEyes);

        // Show/hide password → robot peeks
        const toggle = document.getElementById('togglePw');
        toggle.addEventListener('click', () => {
            if (password.type === 'password') {
                password.type = 'text'; toggle.textContent = 'HIDE';
                robot.classList.remove('peek'); // robot uncovers to peek too
            } else {
                password.type = 'password'; toggle.textContent = 'SHOW';
                if (document.activeElement === password) robot.classList.add('peek');
            }
        });

        // Random blink
        setInterval(() => {
            if (!robot.classList.contains('peek')) {
                robot.classList.add('blink');
                setTimeout(() => robot.classList.remove('blink'), 150);
            }
        }, 3500);

        // ===== WRONG PASSWORD REACTION (if error present) =====
        <% if (typeof error !== 'undefined' && error) { %>
        window.addEventListener('load', () => {
            robot.classList.add('shake', 'sad');
            // sad mouth
            document.getElementById('mouth').setAttribute('d', 'M 54 63 Q 65 57 76 63');
            // red eyes
            document.querySelectorAll('#eyeL circle:first-child, #eyeR circle:first-child').forEach(c => c.setAttribute('fill', '#f87171'));
            setTimeout(() => robot.classList.remove('shake'), 600);
        });
        <% } %>

        // ===== SUCCESS ANIMATION on submit =====
        document.getElementById('loginForm').addEventListener('submit', (e) => {
            robot.classList.remove('peek', 'sad');
            robot.classList.add('happy');
            // happy mouth
            document.getElementById('mouth').setAttribute('d', 'M 52 58 Q 65 68 78 58');
        });
    </script>
</body>
</html>
