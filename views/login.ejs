<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Searvator CRM — Sign in</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root { --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --brand:#2563eb; --brand2:#7c3aed; }
        html, body { height: 100%; }
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
            background: #f4f7ff; color: var(--ink); overflow: hidden; position: relative; padding: 20px;
        }

        /* ═══ AURORA BACKGROUND ═══ */
        .aurora { position: fixed; inset: -20%; z-index: 0; filter: blur(80px); opacity: 0.55; }
        .aurora span { position: absolute; border-radius: 50%; mix-blend-mode: multiply; animation: auroraMove 18s ease-in-out infinite; }
        .aurora .a1 { width: 55vw; height: 55vw; background: radial-gradient(circle, #93c5fd, transparent 65%); top: -10%; left: -10%; }
        .aurora .a2 { width: 50vw; height: 50vw; background: radial-gradient(circle, #c4b5fd, transparent 65%); bottom: -15%; right: -10%; animation-delay: -6s; }
        .aurora .a3 { width: 40vw; height: 40vw; background: radial-gradient(circle, #a5f3fc, transparent 65%); top: 40%; left: 45%; animation-delay: -12s; }
        @keyframes auroraMove {
            0%,100% { transform: translate(0,0) scale(1); }
            33% { transform: translate(6%, -5%) scale(1.12); }
            66% { transform: translate(-5%, 6%) scale(0.94); }
        }
        /* dot grid */
        .grid-dots { position: fixed; inset: 0; z-index: 1; background-image: radial-gradient(rgba(37,99,235,0.10) 1px, transparent 1px); background-size: 26px 26px; mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%); }

        /* ═══ CARD + STAGGERED ENTRANCE ═══ */
        .card {
            position: relative; z-index: 10; width: 100%; max-width: 430px;
            background: rgba(255,255,255,0.9); backdrop-filter: blur(18px);
            border: 1px solid rgba(255,255,255,0.9); border-radius: 30px;
            padding: 36px 38px 30px;
            box-shadow: 0 40px 90px -25px rgba(37,99,235,0.28), 0 10px 30px rgba(15,23,42,0.06);
        }
        .stagger { opacity: 0; transform: translateY(22px); animation: rise 0.7s cubic-bezier(0.16,1,0.3,1) forwards; }
        .d1{animation-delay:.05s}.d2{animation-delay:.15s}.d3{animation-delay:.25s}.d4{animation-delay:.4s}.d5{animation-delay:.5s}.d6{animation-delay:.6s}.d7{animation-delay:.72s}
        @keyframes rise { to { opacity: 1; transform: none; } }

        .greeting { display:flex; align-items:center; gap:8px; justify-content:center; margin-bottom:4px; }
        .greeting .emoji { font-size: 19px; animation: wave 2.6s ease-in-out infinite; transform-origin: 70% 70%; }
        @keyframes wave { 0%,60%,100%{transform:rotate(0)} 10%,30%{transform:rotate(14deg)} 20%{transform:rotate(-8deg)} }
        .greeting .text { font-size: 13.5px; font-weight: 600; color: var(--muted); }
        .brand-name { text-align:center; font-size:26px; font-weight:800; letter-spacing:-0.5px; background: linear-gradient(135deg, #1e3a8a, #7c3aed); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .brand-tag { text-align:center; font-size:10.5px; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:2.5px; margin: 2px 0 14px; }

        /* ═══ ROBOT — floating, mouse-tracking, hands ═══ */
        .robot-stage { display:flex; justify-content:center; margin-bottom: 6px; position: relative; }
        .robot-wrap { position: relative; animation: floatBob 3.2s ease-in-out infinite; }
        @keyframes floatBob { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-9px)} }
        .robot-shadow { width: 90px; height: 12px; background: radial-gradient(ellipse, rgba(15,23,42,0.18), transparent 70%); border-radius: 50%; margin: 2px auto 8px; animation: shadowPulse 3.2s ease-in-out infinite; }
        @keyframes shadowPulse { 0%,100%{transform:scaleX(1); opacity:.8} 50%{transform:scaleX(0.78); opacity:.5} }
        .robot { width: 150px; height: 132px; overflow: visible; }
        .robot * { transform-box: fill-box; }
        .robot .head { transform-origin: center bottom; animation: headTilt 6s ease-in-out infinite; }
        @keyframes headTilt { 0%,42%,100%{transform:rotate(0)} 48%{transform:rotate(-3.5deg)} 54%{transform:rotate(0)} 78%{transform:rotate(3deg)} 84%{transform:rotate(0)} }
        .robot .antenna-tip { animation: glow 1.8s ease-in-out infinite; }
        @keyframes glow { 0%,100%{opacity:1; filter: drop-shadow(0 0 3px #a78bfa)} 50%{opacity:.55; filter: drop-shadow(0 0 8px #7c3aed)} }
        .robot .pupil { transition: transform .12s ease-out; }
        .robot .eye-lid { transform: scaleY(0); transform-origin: center; transition: transform .09s ease; }
        .robot.blink .eye-lid { transform: scaleY(1); }
        /* HANDS: rise up and clearly cover the eyes */
        .robot .hand { transition: transform .45s cubic-bezier(0.34,1.56,0.64,1); }
        .robot.peek .hand-l { transform: translate(30px, -52px) rotate(-14deg); }
        .robot.peek .hand-r { transform: translate(-30px, -52px) rotate(14deg); }
        .robot.shake { animation: shakeX .55s ease; }
        @keyframes shakeX { 0%,100%{transform:translateX(0)} 15%,55%{transform:translateX(-10px)} 35%,75%{transform:translateX(10px)} }
        .robot-wrap.happy { animation: happyJump .7s cubic-bezier(0.34,1.56,0.64,1); }
        @keyframes happyJump { 0%,100%{transform:translateY(0)} 35%{transform:translateY(-22px)} 65%{transform:translateY(-6px)} }

        /* ═══ FIELDS ═══ */
        .field { margin-bottom: 13px; }
        .field label { display:block; font-size:11.5px; font-weight:700; color:var(--muted); margin-bottom:6px; letter-spacing:.3px; }
        .input-wrap { position: relative; }
        .input-wrap > svg { position:absolute; left:14px; top:50%; transform:translateY(-50%); width:18px; height:18px; color:#94a3b8; pointer-events:none; transition: color .2s; }
        .field input {
            width:100%; padding:13px 60px 13px 42px; background:#f8fafc;
            border:1.5px solid var(--line); border-radius:14px; color:var(--ink);
            font-size:14px; font-family:inherit; outline:none; transition: all .22s;
        }
        .field input::placeholder { color:#cbd5e1; }
        .field input:focus { border-color:var(--brand); background:#fff; box-shadow: 0 0 0 4px rgba(37,99,235,.12), 0 4px 14px -6px rgba(37,99,235,.25); }
        .field input:focus ~ svg { color: var(--brand); }
        .toggle-pw { position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:#94a3b8; font-size:11px; font-weight:700; padding:4px; letter-spacing:.5px; }
        .toggle-pw:hover { color: var(--brand); }

        /* ═══ BUTTON ═══ */
        .signin {
            width:100%; padding:15px; margin-top:8px; border:none; border-radius:14px;
            color:#fff; font-size:15px; font-weight:800; font-family:inherit; cursor:pointer;
            background: linear-gradient(120deg, #2563eb, #7c3aed, #2563eb);
            background-size: 220% 100%;
            animation: gradientSlide 4s ease infinite;
            transition: transform .22s, box-shadow .22s; position:relative; overflow:hidden;
        }
        @keyframes gradientSlide { 0%,100%{background-position:0% 50%} 50%{background-position:100% 50%} }
        .signin:hover { transform: translateY(-2.5px); box-shadow: 0 16px 36px -10px rgba(79,70,229,0.55); }
        .signin:active { transform: translateY(0) scale(.99); }
        .signin::after { content:''; position:absolute; top:0; left:-120%; width:60%; height:100%; background: linear-gradient(100deg, transparent, rgba(255,255,255,.45), transparent); transform: skewX(-20deg); animation: sheen 3.2s ease-in-out infinite; }
        @keyframes sheen { 0%,55%{left:-120%} 75%{left:130%} 100%{left:130%} }

        .error-box {
            display:flex; align-items:center; gap:8px; background:#fef2f2; border:1px solid #fecaca;
            color:#b91c1c; padding:11px 14px; border-radius:12px; font-size:13px; font-weight:600;
            margin-bottom:14px; animation: errIn .4s ease;
        }
        @keyframes errIn { from{opacity:0; transform:translateY(-6px)} to{opacity:1; transform:none} }

        .footer { text-align:center; margin-top:20px; font-size:11px; color:#94a3b8; line-height:1.6; }
        .footer strong { color: var(--muted); }

        /* confetti */
        .confetti { position: fixed; width: 9px; height: 9px; z-index: 50; border-radius: 2px; pointer-events: none; }

        @media (max-width:480px){ .card{padding:28px 22px} .brand-name{font-size:23px} }
        @media (prefers-reduced-motion: reduce){ *{animation:none !important; transition:none !important} .stagger{opacity:1; transform:none} }
    </style>
</head>
<body>
    <div class="aurora"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
    <div class="grid-dots"></div>

    <div class="card">
        <div class="greeting stagger d1">
            <span class="emoji" id="greetEmoji">👋</span>
            <span class="text" id="greetText">Welcome back</span>
        </div>
        <h1 class="brand-name stagger d2">Searvator CRM</h1>
        <p class="brand-tag stagger d2">Search and Facilitator</p>

        <div class="robot-stage stagger d3">
            <div class="robot-wrap" id="robotWrap">
                <svg class="robot" id="robot" viewBox="0 0 150 132" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g class="head">
                        <line x1="75" y1="16" x2="75" y2="7" stroke="#94a3b8" stroke-width="3" stroke-linecap="round"/>
                        <circle class="antenna-tip" cx="75" cy="5" r="4.5" fill="#7c3aed"/>
                        <rect x="33" y="16" width="84" height="64" rx="20" fill="#f1f4f9" stroke="#cbd5e1" stroke-width="2"/>
                        <rect x="42" y="27" width="66" height="43" rx="14" fill="#0f172a"/>
                        <g id="eyeL">
                            <circle cx="60" cy="46" r="7.5" fill="#38bdf8"/>
                            <circle class="pupil pupilL" cx="60" cy="46" r="3.2" fill="#fff"/>
                            <rect class="eye-lid" x="52" y="38" width="16" height="16" rx="5" fill="#0f172a"/>
                        </g>
                        <g id="eyeR">
                            <circle cx="90" cy="46" r="7.5" fill="#38bdf8"/>
                            <circle class="pupil pupilR" cx="90" cy="46" r="3.2" fill="#fff"/>
                            <rect class="eye-lid" x="82" y="38" width="16" height="16" rx="5" fill="#0f172a"/>
                        </g>
                        <path class="mouth" id="mouth" d="M 62 61 Q 75 66 88 61" stroke="#38bdf8" stroke-width="2.6" stroke-linecap="round" fill="none"/>
                    </g>
                    <rect x="47" y="82" width="56" height="32" rx="13" fill="#f1f4f9" stroke="#cbd5e1" stroke-width="2"/>
                    <circle cx="63" cy="98" r="3" fill="#cbd5e1"/><circle cx="75" cy="98" r="3" fill="#cbd5e1"/><circle cx="87" cy="98" r="3" fill="#cbd5e1"/>
                    <!-- hands (cover eyes on password) -->
                    <g class="hand hand-l">
                        <rect x="22" y="86" width="24" height="11" rx="5.5" fill="#cbd5e1"/>
                        <circle cx="24" cy="91" r="9" fill="#94a3b8"/>
                    </g>
                    <g class="hand hand-r">
                        <rect x="104" y="86" width="24" height="11" rx="5.5" fill="#cbd5e1"/>
                        <circle cx="126" cy="91" r="9" fill="#94a3b8"/>
                    </g>
                </svg>
                <div class="robot-shadow"></div>
            </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error-box stagger d4">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <form method="POST" action="/login" id="loginForm">
            <div class="field stagger d4">
                <label>Username</label>
                <div class="input-wrap">
                    <input type="text" name="username" id="username" required autofocus placeholder="Enter your username" autocomplete="username">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
            </div>
            <div class="field stagger d5">
                <label>Password</label>
                <div class="input-wrap">
                    <input type="password" name="password" id="password" required placeholder="Enter your password" autocomplete="current-password">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    <button type="button" class="toggle-pw" id="togglePw" tabindex="-1">SHOW</button>
                </div>
            </div>
            <button type="submit" class="signin stagger d6">Sign in →</button>
        </form>

        <div class="footer stagger d7">
            <strong>Searvator IT Solutions Pvt. Ltd.</strong><br>
            Secure business management portal
        </div>
    </div>

    <script>
        // ═══ TIME-BASED GREETING ═══
        (function() {
            const h = new Date().getHours();
            let e, t;
            if (h >= 5 && h < 12)       { e='☀️'; t='Good morning'; }
            else if (h >= 12 && h < 17) { e='🌤️'; t='Good afternoon'; }
            else if (h >= 17 && h < 21) { e='🌇'; t='Good evening'; }
            else                        { e='🌙'; t='Working late? Good night'; }
            document.getElementById('greetEmoji').textContent = e;
            document.getElementById('greetText').textContent = t;
        })();

        const robot = document.getElementById('robot');
        const robotWrap = document.getElementById('robotWrap');
        const username = document.getElementById('username');
        const password = document.getElementById('password');
        const pupils = document.querySelectorAll('.pupil');
        const mouth = document.getElementById('mouth');

        // ═══ EYES FOLLOW MOUSE (whole page) ═══
        let covering = false;
        document.addEventListener('mousemove', (ev) => {
            if (covering) return;
            const r = robot.getBoundingClientRect();
            const cx = r.left + r.width / 2, cy = r.top + r.height * 0.36;
            const dx = ev.clientX - cx, dy = ev.clientY - cy;
            const dist = Math.min(1, Math.hypot(dx, dy) / 300);
            const ang = Math.atan2(dy, dx);
            const mx = Math.cos(ang) * 2.6 * dist, my = Math.sin(ang) * 2.2 * dist;
            pupils.forEach(p => p.style.transform = `translate(${mx}px, ${my}px)`);
        });

        // typing in username → eyes look at field + smile grows
        username.addEventListener('input', () => {
            const len = Math.min(username.value.length, 14);
            mouth.setAttribute('d', `M 62 61 Q 75 ${66 + Math.min(4, len * 0.4)} 88 61`);
        });

        // ═══ COVER EYES ON PASSWORD (focus OR has value) ═══
        function updateCover() {
            const should = (document.activeElement === password && password.type === 'password') || (password.value.length > 0 && password.type === 'password' && document.activeElement === password);
            covering = document.activeElement === password && password.type === 'password';
            robot.classList.toggle('peek', covering);
            if (covering) pupils.forEach(p => p.style.transform = '');
        }
        password.addEventListener('focus', updateCover);
        password.addEventListener('blur', updateCover);
        password.addEventListener('input', updateCover);

        const toggle = document.getElementById('togglePw');
        toggle.addEventListener('click', () => {
            if (password.type === 'password') { password.type = 'text'; toggle.textContent = 'HIDE'; }
            else { password.type = 'password'; toggle.textContent = 'SHOW'; }
            updateCover(); password.focus();
        });

        // ═══ RANDOM BLINK ═══
        setInterval(() => {
            if (!covering) {
                robot.classList.add('blink');
                setTimeout(() => robot.classList.remove('blink'), 140);
            }
        }, 3200);

        // ═══ WRONG PASSWORD REACTION ═══
        <% if (typeof error !== 'undefined' && error) { %>
        window.addEventListener('load', () => {
            setTimeout(() => {
                robot.classList.add('shake');
                mouth.setAttribute('d', 'M 62 65 Q 75 58 88 65');
                document.querySelectorAll('#eyeL circle:first-child, #eyeR circle:first-child').forEach(c => c.setAttribute('fill', '#f87171'));
                setTimeout(() => robot.classList.remove('shake'), 650);
            }, 350);
        });
        <% } %>

        // ═══ SUCCESS: happy jump + confetti ═══
        document.getElementById('loginForm').addEventListener('submit', () => {
            covering = false;
            robot.classList.remove('peek');
            robotWrap.classList.add('happy');
            mouth.setAttribute('d', 'M 60 58 Q 75 70 90 58');
            document.querySelectorAll('#eyeL circle:first-child, #eyeR circle:first-child').forEach(c => c.setAttribute('fill', '#4ade80'));
            // confetti burst
            const colors = ['#2563eb','#7c3aed','#f59e0b','#10b981','#ef4444'];
            const r = robot.getBoundingClientRect();
            for (let i = 0; i < 26; i++) {
                const c = document.createElement('div');
                c.className = 'confetti';
                c.style.background = colors[i % colors.length];
                c.style.left = (r.left + r.width/2) + 'px';
                c.style.top = (r.top + r.height/2) + 'px';
                document.body.appendChild(c);
                const ang = (Math.PI * 2 * i) / 26 + Math.random() * 0.4;
                const v = 90 + Math.random() * 130;
                c.animate([
                    { transform: 'translate(0,0) rotate(0)', opacity: 1 },
                    { transform: `translate(${Math.cos(ang)*v}px, ${Math.sin(ang)*v + 70}px) rotate(${Math.random()*540}deg)`, opacity: 0 }
                ], { duration: 850 + Math.random()*350, easing: 'cubic-bezier(0.16,1,0.3,1)' });
                setTimeout(() => c.remove(), 1200);
            }
        });
    </script>
</body>
</html>
