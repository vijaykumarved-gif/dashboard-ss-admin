<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= quotation ? 'Edit Quotation' : 'New Quotation' %> — Searvator CRM</title>
    <link rel="stylesheet" href="/css/main.css">
    <%- include('partials/mobile-head') %>
    <style>
        .builder-grid { display: grid; grid-template-columns: 1fr 380px; gap: 20px; align-items: start; }
        @media (max-width: 1100px) { .builder-grid { grid-template-columns: 1fr; } }
        .product-picker { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 20px; position: sticky; top: 20px; max-height: calc(100vh - 40px); overflow-y: auto; }
        .product-search { width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 12px; font-size: 13px; }
        .product-item { padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 8px; cursor: pointer; transition: all 0.2s var(--ease); }
        .product-item:hover { border-color: var(--accent); background: var(--surface-2); transform: translateX(2px); }
        .product-item-name { font-weight: 600; font-size: 13px; }
        .product-item-meta { font-size: 11px; color: var(--text-3); margin-top: 2px; }
        .item-row { display: grid; grid-template-columns: 1fr 80px 80px 100px 60px 100px 36px; gap: 8px; padding: 10px; border-bottom: 1px solid var(--border); align-items: center; }
        .item-row:last-child { border-bottom: none; }
        .item-row input { padding: 6px 8px; font-size: 12px; }
        .items-header { display: grid; grid-template-columns: 1fr 80px 80px 100px 60px 100px 36px; gap: 8px; padding: 10px; background: var(--surface-2); border-bottom: 1px solid var(--border); font-size: 11px; font-weight: 600; color: var(--text-2); text-transform: uppercase; letter-spacing: 0.05em; }
        .totals-row { display: flex; justify-content: space-between; padding: 8px 0; }
        .totals-row.grand { padding-top: 12px; border-top: 2px solid var(--text); font-weight: 800; font-size: 18px; margin-top: 8px; }
        .remove-btn { width: 28px; height: 28px; border-radius: 6px; background: var(--danger-light); color: var(--danger); border: none; cursor: pointer; font-size: 16px; display: grid; place-items: center; }
    </style>
</head>
<body>
<div class="app-layout">
    <%- include('partials/sidebar', { user, activePage: 'cctv' }) %>
    
    <main class="main-content">
        <div style="margin-bottom: 12px;">
            <a href="/cctv" style="color: var(--text-3); text-decoration: none; font-size: 13px;">← Back to CCTV</a>
        </div>
        
        <div class="page-header">
            <div>
                <h1 class="page-title"><%= quotation ? 'Edit Quotation' : 'New Quotation' %></h1>
                <p class="page-subtitle">
                    <% if (quotation) { %>
                        <%= quotation.quotationNumber %>
                    <% } else { %>
                        Pick products from the catalog or add custom items
                    <% } %>
                </p>
            </div>
            <div class="flex gap-2">
                <% if (quotation) { %>
                    <a href="/api/quotations/<%= quotation._id %>/pdf" target="_blank" class="btn btn-secondary">📄 Preview PDF</a>
                <% } %>
                <button class="btn btn-primary" onclick="saveQuotation()">💾 Save Quotation</button>
            </div>
        </div>
        
        <div class="builder-grid">
            <!-- LEFT: Quotation Form -->
            <div>
                <!-- Client Info -->
                <div class="card">
                    <div class="card-header"><div class="card-title">Client Information</div></div>
                    <div class="card-body">
                        <!-- CUSTOMER AUTO-FILL SEARCH -->
                        <div style="margin-bottom: 16px; padding: 12px 14px; background: linear-gradient(135deg, #eff6ff, #ffffff); border: 1px solid #bfdbfe; border-radius: 10px; position: relative;">
                            <label class="form-label" style="color: #1e40af; font-weight: 700;">🔍 Quick Fill - Search Existing Customer</label>
                            <input type="text" id="custSearch" placeholder="Type mobile number, name, or company..." autocomplete="off"
                                style="width: 100%; margin-top: 4px;"
                                oninput="searchCustomer(this.value)" onfocus="searchCustomer(this.value)">
                            <div id="custSuggestions" style="display: none; position: absolute; left: 14px; right: 14px; top: 72px; background: white; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,0.12); max-height: 280px; overflow-y: auto; z-index: 50;"></div>
                            <div style="font-size: 11px; color: var(--text-3); margin-top: 6px;">
                                💡 Customer ka mobile/name daalo → details auto-fill ho jayengi. Naya customer ho to niche manually bharo.
                            </div>
                        </div>
                        
                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">Client Name *</label>
                                <input type="text" id="q_client" value="<%= quotation ? quotation.clientName : '' %>">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Company</label>
                                <input type="text" id="q_company" value="<%= quotation ? quotation.clientCompany : '' %>">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Mobile</label>
                                <input type="text" id="q_mobile" value="<%= quotation ? quotation.clientMobile : '' %>">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Email</label>
                                <input type="email" id="q_email" value="<%= quotation ? quotation.clientEmail : '' %>">
                            </div>
                            <div class="form-group" style="grid-column: span 2;">
                                <label class="form-label">Address</label>
                                <textarea id="q_address" rows="2"><%= quotation ? quotation.clientAddress : '' %></textarea>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Project Type</label>
                                <select id="q_type">
                                    <% ['CCTV Installation','Biometric','Desktop Computer','Laptop','Computer Parts/Upgrade','Server','Printer/Scanner','AMC','Hybrid Setup','Other'].forEach(s => { %>
                                        <option <%= quotation && quotation.projectType === s ? 'selected' : '' %>><%= s %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Site Location</label>
                                <input type="text" id="q_site" value="<%= quotation ? quotation.siteLocation : '' %>">
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Items -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">Items</div>
                            <div class="card-subtitle">Pick products from catalog →, or add custom items below</div>
                        </div>
                        <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                            <span style="font-size: 11px; color: var(--text-3); font-weight: 600;">Set all GST:</span>
                            <button class="btn btn-xs btn-secondary" onclick="setAllGst(0)" style="background:#dcfce7; color:#166534;">0%</button>
                            <button class="btn btn-xs btn-secondary" onclick="setAllGst(5)">5%</button>
                            <button class="btn btn-xs btn-secondary" onclick="setAllGst(12)">12%</button>
                            <button class="btn btn-xs btn-secondary" onclick="setAllGst(18)">18%</button>
                            <button class="btn btn-xs btn-secondary" onclick="setAllGst(28)">28%</button>
                            <button class="btn btn-secondary btn-sm" onclick="addCustomItem()">+ Custom Item</button>
                        </div>
                    </div>
                    <div>
                        <div class="items-header">
                            <div>Item Name</div>
                            <div>Qty</div>
                            <div>Unit</div>
                            <div>Price</div>
                            <div>GST%</div>
                            <div class="text-right">Total</div>
                            <div></div>
                        </div>
                        <div id="itemsContainer"></div>
                        <div id="emptyItems" style="padding: 40px; text-align: center; color: var(--text-3);">
                            No items added. Pick from product catalog on the right →
                        </div>
                    </div>
                </div>
                
                <!-- Terms & Totals -->
                <div class="card">
                    <div class="card-header"><div class="card-title">Terms & Pricing</div></div>
                    <div class="card-body">
                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">Installation Charges (₹)</label>
                                <input type="number" id="q_install" value="<%= quotation ? quotation.installationCharges : 0 %>" onchange="recalcTotals()">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Discount (₹)</label>
                                <input type="number" id="q_discount" value="<%= quotation ? quotation.discount : 0 %>" onchange="recalcTotals()">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Validity (days)</label>
                                <input type="number" id="q_validity" value="<%= quotation ? quotation.validityDays : 15 %>">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Status</label>
                                <select id="q_status">
                                    <% ['Draft','Sent','Approved','Rejected','Expired'].forEach(s => { %>
                                        <option <%= quotation && quotation.status === s ? 'selected' : '' %>><%= s %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group" style="grid-column: span 2;">
                                <label class="form-label">Payment Terms</label>
                                <input type="text" id="q_payment" value="<%= quotation ? quotation.paymentTerms : '50% advance, 50% on completion' %>">
                            </div>
                            <div class="form-group" style="grid-column: span 2;">
                                <label class="form-label">Warranty</label>
                                <input type="text" id="q_warranty" value="<%= quotation ? quotation.warranty : '1 Year Manufacturer Warranty' %>">
                            </div>
                            <div class="form-group" style="grid-column: span 2;">
                                <label class="form-label">Additional Notes</label>
                                <textarea id="q_notes" rows="2"><%= quotation ? quotation.notes : '' %></textarea>
                            </div>
                        </div>
                        
                        <div style="margin-top: 20px; padding: 16px; background: var(--surface-2); border-radius: var(--radius);">
                            <div class="totals-row"><span>Subtotal:</span><span id="t_subtotal" class="font-mono">₹0</span></div>
                            <div class="totals-row"><span>GST:</span><span id="t_gst" class="font-mono">₹0</span></div>
                            <div class="totals-row"><span>Installation:</span><span id="t_install" class="font-mono">₹0</span></div>
                            <div class="totals-row"><span>Discount:</span><span id="t_discount" class="font-mono text-danger">₹0</span></div>
                            <div class="totals-row grand"><span>GRAND TOTAL:</span><span id="t_grand" class="font-mono">₹0</span></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- RIGHT: Product Picker -->
            <div class="product-picker">
                <div class="font-bold mb-2" style="font-size: 14px;">⚡ Quick Add - Computer Parts</div>
                <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px;">
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('Desktop PC (Assembled)', 'Intel i5 12th Gen, 16GB DDR4, 512GB SSD, Cabinet', '1 Year', 35000)">🖥️ Desktop PC</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('Laptop', 'Intel i5, 8GB RAM, 512GB SSD, 15.6 inch', '1 Year', 45000)">💻 Laptop</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('RAM 8GB DDR4', '8GB DDR4 3200MHz', '3 Years', 1500)">RAM 8GB</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('RAM 16GB DDR4', '16GB DDR4 3200MHz', '3 Years', 2800)">RAM 16GB</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('SSD 256GB', '256GB SATA SSD', '3 Years', 1800)">SSD 256GB</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('SSD 512GB', '512GB NVMe SSD', '3 Years', 3200)">SSD 512GB</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('SSD 1TB', '1TB NVMe SSD', '3 Years', 5500)">SSD 1TB</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('HDD 1TB', '1TB 7200RPM SATA', '2 Years', 3000)">HDD 1TB</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('Monitor 22 inch', '22 inch FHD LED', '3 Years', 7000)">Monitor 22\"</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('Keyboard + Mouse', 'USB Wired Combo', '1 Year', 600)">KB+Mouse</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('SMPS / Power Supply', '500W Power Supply', '1 Year', 1200)">SMPS</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('Cabinet', 'ATX Cabinet with Fans', '1 Year', 1500)">Cabinet</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('Motherboard', 'H610 / B660 Chipset', '3 Years', 8000)">Motherboard</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('Processor', 'Intel i5 12th Gen', '3 Years', 14000)">Processor</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('Graphics Card', 'GTX 1650 4GB', '3 Years', 12000)">GPU</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('UPS', '600VA UPS Backup', '1 Year', 2500)">UPS</button>
                    <button class="btn btn-xs btn-secondary" onclick="quickAdd('Windows 11 License', 'Genuine Windows 11 Pro', 'Lifetime', 8000)">Windows</button>
                    <button class="btn btn-xs" style="background: #16a34a; color: white;" onclick="addCustomItem()">+ Custom</button>
                </div>
                
                <div class="font-bold mb-2" style="font-size: 14px;">📦 Pick from Catalog</div>
                <input type="text" class="product-search" id="productSearch" placeholder="Search products..." oninput="filterProducts()">
                <div id="productList">
                    <% if (products.length === 0) { %>
                        <div style="padding: 20px; text-align: center; color: var(--text-3); font-size: 12px;">
                            No products in catalog. Use Quick Add buttons above ⬆️
                        </div>
                    <% } else { products.forEach(p => { %>
                        <div class="product-item" data-name="<%= p.productName.toLowerCase() %>" onclick='addProduct(<%- JSON.stringify(p) %>)'>
                            <div class="product-item-name"><%= p.productName %></div>
                            <div class="product-item-meta">
                                <%= p.category %> · <%= p.brand %> · <strong>₹<%= p.sellingPrice.toLocaleString('en-IN') %></strong>/<%= p.unit %>
                            </div>
                        </div>
                    <% }) } %>
                </div>
            </div>
        </div>
        
        <!-- ===== ORDER LIFECYCLE + PAYMENT HISTORY (after approval) ===== -->
        <% if (quotation && (quotation.status === 'Approved' || quotation.status === 'Converted')) { 
            const totalPaid = quotation.totalPaid || 0;
            const balanceDue = Math.max(0, (quotation.grandTotal || 0) - totalPaid);
            const fmtD = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
        %>
        <div class="card" id="lifecycle" style="border: 2px solid #0ea5e9; margin-top: 16px;">
            <div class="card-header" style="background: linear-gradient(135deg, #f0f9ff, #ffffff);">
                <div>
                    <div class="card-title" style="color: #0369a1;">📦 Order Summary & Payment History</div>
                    <div class="card-subtitle">Order dates, delivery, installation & all payment transactions</div>
                </div>
                <div style="display: flex; gap: 8px;">
                    <button class="btn btn-sm btn-success" onclick="openPaymentModal()">💰 Record Payment</button>
                    <button class="btn btn-sm btn-secondary" onclick="openLifecycleModal()">📅 Update Dates</button>
                </div>
            </div>
            <div class="card-body">
                <!-- Payment summary -->
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px;">
                    <div style="background: #eff6ff; padding: 14px; border-radius: 10px; text-align: center;">
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">Total Order Value</div>
                        <div style="font-size: 20px; font-weight: 800; color: #1e40af;"><%= formatINR(quotation.grandTotal) %></div>
                    </div>
                    <div style="background: #f0fdf4; padding: 14px; border-radius: 10px; text-align: center;">
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">Total Received</div>
                        <div style="font-size: 20px; font-weight: 800; color: #16a34a;" id="ls_paid"><%= formatINR(totalPaid) %></div>
                    </div>
                    <div style="background: <%= balanceDue > 0 ? '#fef2f2' : '#f0fdf4' %>; padding: 14px; border-radius: 10px; text-align: center;">
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">Balance Due</div>
                        <div style="font-size: 20px; font-weight: 800; color: <%= balanceDue > 0 ? '#dc2626' : '#16a34a' %>;" id="ls_due"><%= formatINR(balanceDue) %></div>
                    </div>
                </div>
                
                <!-- Order lifecycle timeline -->
                <div style="background: var(--surface-2); border-radius: 10px; padding: 16px; margin-bottom: 16px;">
                    <div style="font-weight: 700; font-size: 13px; margin-bottom: 12px;">📅 Order Lifecycle</div>
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;">
                        <div style="text-align: center;">
                            <div style="font-size: 22px;">📋</div>
                            <div style="font-size: 10px; color: var(--text-3);">Order Received</div>
                            <div style="font-size: 12px; font-weight: 700;"><%= fmtD(quotation.orderReceivedDate) %></div>
                        </div>
                        <div style="text-align: center;">
                            <div style="font-size: 22px;">🚚</div>
                            <div style="font-size: 10px; color: var(--text-3);">Delivered</div>
                            <div style="font-size: 12px; font-weight: 700;"><%= fmtD(quotation.actualDeliveryDate) %></div>
                            <% if (quotation.expectedDeliveryDate && !quotation.actualDeliveryDate) { %>
                                <div style="font-size: 9px; color: #d97706;">Exp: <%= fmtD(quotation.expectedDeliveryDate) %></div>
                            <% } %>
                        </div>
                        <div style="text-align: center;">
                            <div style="font-size: 22px;">🔧</div>
                            <div style="font-size: 10px; color: var(--text-3);">Installation</div>
                            <div style="font-size: 12px; font-weight: 700;"><%= fmtD(quotation.installationDate) %></div>
                            <div style="font-size: 9px; color: var(--text-3);"><%= quotation.installationStatus || 'Pending' %></div>
                        </div>
                        <div style="text-align: center;">
                            <div style="font-size: 22px;">💵</div>
                            <div style="font-size: 10px; color: var(--text-3);">Advance</div>
                            <div style="font-size: 12px; font-weight: 700;"><%= formatINR(quotation.advanceReceived || 0) %></div>
                            <% if (quotation.advanceDate) { %><div style="font-size: 9px; color: var(--text-3);"><%= fmtD(quotation.advanceDate) %></div><% } %>
                        </div>
                    </div>
                </div>
                
                <!-- Payment transactions table -->
                <div style="font-weight: 700; font-size: 13px; margin-bottom: 8px;">💳 Payment Transactions (<%= (quotation.payments || []).length %>)</div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr><th>#</th><th>Date</th><th>Amount</th><th>Type</th><th>Mode</th><th>Reference</th><th>Recorded By</th></tr>
                        </thead>
                        <tbody>
                            <% if (!quotation.payments || quotation.payments.length === 0) { %>
                                <tr><td colspan="7" style="text-align: center; padding: 20px; color: var(--text-3);">No payments recorded yet</td></tr>
                            <% } else { quotation.payments.slice().reverse().forEach((p, i) => { 
                                const num = quotation.payments.length - i;
                            %>
                                <tr>
                                    <td class="font-mono"><%= num %></td>
                                    <td style="font-size: 12px;"><%= new Date(p.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                                    <td class="font-mono font-bold" style="color: #16a34a;"><%= formatINR(p.amount) %></td>
                                    <td><span class="badge <%= p.type === 'Advance' ? 'info' : 'success' %>" style="font-size: 9px;"><%= p.type %></span></td>
                                    <td style="font-size: 12px;"><%= p.mode %></td>
                                    <td style="font-size: 11px; color: var(--text-3);"><%= p.reference || '—' %></td>
                                    <td style="font-size: 11px; color: var(--text-3);"><%= p.recordedBy || '—' %></td>
                                </tr>
                            <% }) } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <% } %>
        
        <!-- ===== VENDOR PROCUREMENT (after approval) ===== -->
        <% if (quotation && (quotation.status === 'Approved' || quotation.status === 'Converted')) { %>
        <div class="card" id="vendor" style="border: 2px solid #8b5cf6; margin-top: 16px;">
            <div class="card-header" style="background: linear-gradient(135deg, #faf5ff, #ffffff);">
                <div>
                    <div class="card-title" style="color: #6b21a8;">🏪 Vendor Procurement & Profit Tracking</div>
                    <div class="card-subtitle">Quotation approved! Now track vendor cost, payments & delivery</div>
                </div>
                <button class="btn btn-primary btn-sm" onclick="openVendorModal()">+ Add Vendor Item</button>
            </div>
            <div class="card-body">
                <!-- Profit summary -->
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 16px;">
                    <div style="background: #eff6ff; padding: 12px; border-radius: 10px; text-align: center;">
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">Quote Value</div>
                        <div style="font-size: 16px; font-weight: 800; color: #1e40af;"><%= formatINR(quotation.grandTotal) %></div>
                    </div>
                    <div style="background: #fef2f2; padding: 12px; border-radius: 10px; text-align: center;">
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">Vendor Cost</div>
                        <div style="font-size: 16px; font-weight: 800; color: #dc2626;" id="vp_cost"><%= formatINR(quotation.totalVendorCost || 0) %></div>
                    </div>
                    <div style="background: #f0fdf4; padding: 12px; border-radius: 10px; text-align: center;">
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">Gross Profit</div>
                        <div style="font-size: 16px; font-weight: 800; color: #16a34a;" id="vp_profit"><%= formatINR((quotation.grandTotal || 0) - (quotation.totalVendorCost || 0)) %></div>
                    </div>
                    <div style="background: #fffbeb; padding: 12px; border-radius: 10px; text-align: center;">
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">Vendor Paid</div>
                        <div style="font-size: 16px; font-weight: 800; color: #d97706;" id="vp_paid"><%= formatINR(quotation.totalVendorPaid || 0) %></div>
                    </div>
                </div>
                
                <!-- Vendor items table -->
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr><th>Vendor</th><th>Product</th><th>Qty × Price</th><th>Delivery</th><th>Total Cost</th><th>Paid</th><th>Pay Status</th><th>Delivery</th><th>Action</th></tr>
                        </thead>
                        <tbody id="vendorTableBody">
                            <% (quotation.vendorProcurement || []).forEach((v, vi) => { 
                                const payClass = v.vendorPaymentStatus === 'Paid' ? 'success' : v.vendorPaymentStatus === 'Partial' ? 'warning' : 'danger';
                                const delClass = v.deliveryStatus === 'Received' ? 'success' : v.deliveryStatus === 'In Transit' ? 'info' : 'warning';
                            %>
                                <tr>
                                    <td class="font-bold" style="font-size:12px;"><%= v.vendorName %></td>
                                    <td style="font-size:11px;"><%= v.productName %></td>
                                    <td class="font-mono" style="font-size:11px;"><%= v.quantity %> × <%= formatINR(v.vendorPrice) %></td>
                                    <td class="font-mono" style="font-size:11px;"><%= formatINR(v.deliveryCharges) %></td>
                                    <td class="font-mono font-bold"><%= formatINR(v.totalVendorCost) %></td>
                                    <td class="font-mono" style="color:#16a34a;"><%= formatINR(v.paymentToVendor) %></td>
                                    <td><span class="badge <%= payClass %>" style="font-size:9px;"><%= v.vendorPaymentStatus %></span></td>
                                    <td>
                                        <select class="status-select" onchange="updateVendorDelivery(<%= vi %>, this.value)" style="font-size:10px; padding:2px 4px;">
                                            <% ['Ordered','In Transit','Received'].forEach(d => { %>
                                                <option <%= v.deliveryStatus === d ? 'selected' : '' %>><%= d %></option>
                                            <% }) %>
                                        </select>
                                    </td>
                                    <td>
                                        <button class="btn btn-xs btn-success" onclick="payVendor(<%= vi %>, <%= v.totalVendorCost - v.paymentToVendor %>)">💰 Pay</button>
                                        <button class="btn btn-xs btn-danger" onclick="deleteVendor(<%= vi %>)">×</button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                    <% if (!quotation.vendorProcurement || quotation.vendorProcurement.length === 0) { %>
                        <div style="padding: 24px; text-align: center; color: var(--text-3); font-size: 13px;">
                            No vendor items yet. Click <strong>+ Add Vendor Item</strong> to track procurement.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
        <% } %>
    </main>
</div>

<!-- PAYMENT MODAL -->
<div class="modal-overlay" id="paymentModal">
    <div class="modal" style="max-width: 460px;">
        <div class="modal-header">
            <div class="modal-title">💰 Record Customer Payment</div>
            <button class="modal-close" onclick="closeModal('paymentModal')">×</button>
        </div>
        <div class="modal-body">
            <% if (quotation) { %>
            <div style="background: #f0f9ff; border-radius: 8px; padding: 12px; margin-bottom: 14px; text-align: center;">
                <div style="font-size: 11px; color: var(--text-3);">Balance Due</div>
                <div style="font-size: 22px; font-weight: 800; color: #dc2626;" id="pm_due"><%= formatINR(Math.max(0, (quotation.grandTotal || 0) - (quotation.totalPaid || 0))) %></div>
            </div>
            <% } %>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Amount Received (₹) *</label>
                    <input type="number" id="pm_amount" placeholder="0" style="font-size: 18px; font-weight: 700;">
                </div>
                <div class="form-group">
                    <label class="form-label">Payment Date</label>
                    <input type="date" id="pm_date" value="<%= new Date().toISOString().split('T')[0] %>">
                </div>
                <div class="form-group">
                    <label class="form-label">Mode</label>
                    <select id="pm_mode">
                        <option>Cash</option><option>UPI</option><option>Bank Transfer</option><option>Cheque</option><option>Card</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Type</label>
                    <select id="pm_type">
                        <option>Payment</option><option>Advance</option><option>Final</option>
                    </select>
                </div>
                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Reference / Note</label>
                    <input type="text" id="pm_ref" placeholder="UTR / Cheque no / note">
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('paymentModal')">Cancel</button>
            <button class="btn btn-success" onclick="savePayment()">Record Payment</button>
        </div>
    </div>
</div>

<!-- LIFECYCLE DATES MODAL -->
<div class="modal-overlay" id="lifecycleModal">
    <div class="modal" style="max-width: 460px;">
        <div class="modal-header">
            <div class="modal-title">📅 Update Order Dates</div>
            <button class="modal-close" onclick="closeModal('lifecycleModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">📋 Order Received Date</label>
                    <input type="date" id="lc_order" value="<%= quotation && quotation.orderReceivedDate ? new Date(quotation.orderReceivedDate).toISOString().split('T')[0] : '' %>">
                </div>
                <div class="form-group">
                    <label class="form-label">🚚 Expected Delivery</label>
                    <input type="date" id="lc_expected" value="<%= quotation && quotation.expectedDeliveryDate ? new Date(quotation.expectedDeliveryDate).toISOString().split('T')[0] : '' %>">
                </div>
                <div class="form-group">
                    <label class="form-label">✅ Actual Delivery Date</label>
                    <input type="date" id="lc_delivered" value="<%= quotation && quotation.actualDeliveryDate ? new Date(quotation.actualDeliveryDate).toISOString().split('T')[0] : '' %>">
                </div>
                <div class="form-group">
                    <label class="form-label">🔧 Installation Date</label>
                    <input type="date" id="lc_install" value="<%= quotation && quotation.installationDate ? new Date(quotation.installationDate).toISOString().split('T')[0] : '' %>">
                </div>
                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Installation Status</label>
                    <select id="lc_installStatus">
                        <% ['Pending','Scheduled','Done'].forEach(s => { %>
                            <option <%= quotation && quotation.installationStatus === s ? 'selected' : '' %>><%= s %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('lifecycleModal')">Cancel</button>
            <button class="btn btn-primary" onclick="saveLifecycle()">Save Dates</button>
        </div>
    </div>
</div>

<!-- VENDOR ADD MODAL -->
<div class="modal-overlay" id="vendorModal">
    <div class="modal" style="max-width: 520px;">
        <div class="modal-header">
            <div class="modal-title">🏪 Add Vendor Procurement</div>
            <button class="modal-close" onclick="closeModal('vendorModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Vendor Name *</label>
                    <input type="text" id="v_name" list="vendorList" placeholder="Type or select">
                    <datalist id="vendorList"></datalist>
                </div>
                <div class="form-group">
                    <label class="form-label">Product *</label>
                    <input type="text" id="v_product" placeholder="e.g. Desktop PC">
                </div>
                <div class="form-group">
                    <label class="form-label">Quantity</label>
                    <input type="number" id="v_qty" value="1" oninput="calcVendorTotal()">
                </div>
                <div class="form-group">
                    <label class="form-label">Vendor Price (per unit ₹)</label>
                    <input type="number" id="v_price" value="0" oninput="calcVendorTotal()">
                </div>
                <div class="form-group">
                    <label class="form-label">Delivery Charges (₹)</label>
                    <input type="number" id="v_delivery" value="0" oninput="calcVendorTotal()">
                </div>
                <div class="form-group">
                    <label class="form-label">Expected Delivery</label>
                    <input type="date" id="v_expected">
                </div>
                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Notes</label>
                    <input type="text" id="v_notes" placeholder="Any notes">
                </div>
            </div>
            <div style="margin-top: 12px; padding: 12px; background: #faf5ff; border-radius: 8px; text-align: center;">
                <span style="font-size: 12px; color: var(--text-3);">Total Vendor Cost: </span>
                <span style="font-size: 18px; font-weight: 800; color: #6b21a8;" id="v_total">₹0</span>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('vendorModal')">Cancel</button>
            <button class="btn btn-primary" onclick="saveVendor()">Add Vendor Item</button>
        </div>
    </div>
</div>

<script src="/js/common.js"></script>
<script>
    let items = <%- quotation ? JSON.stringify(quotation.items) : '[]' %>;
    const QUOTATION_ID = '<%= quotation ? quotation._id : "" %>';
    
    function formatINR(n) { return '₹' + (Number(n) || 0).toLocaleString('en-IN'); }
    
    function renderItems() {
        const container = document.getElementById('itemsContainer');
        const empty = document.getElementById('emptyItems');
        if (items.length === 0) {
            container.innerHTML = '';
            empty.style.display = 'block';
        } else {
            empty.style.display = 'none';
            container.innerHTML = items.map((it, idx) => `
                <div class="item-row">
                    <div>
                        <input type="text" value="${it.productName || ''}" oninput="updateItem(${idx}, 'productName', this.value)" placeholder="Item name">
                        <input type="text" value="${it.specifications || ''}" oninput="updateItem(${idx}, 'specifications', this.value)" placeholder="Spec (e.g. i5 12th Gen, 16GB RAM, 512GB SSD)" style="margin-top: 4px; font-size: 11px;">
                        <input type="text" value="${it.warranty || '1 Year'}" oninput="updateItem(${idx}, 'warranty', this.value)" placeholder="Warranty (e.g. 1 Year, 3 Years)" style="margin-top: 4px; font-size: 11px; color: #16a34a;">
                    </div>
                    <input type="number" value="${it.quantity || 1}" oninput="updateItem(${idx}, 'quantity', this.value)" min="1">
                    <input type="text" value="${it.unit || 'Pcs'}" oninput="updateItem(${idx}, 'unit', this.value)">
                    <input type="number" value="${it.unitPrice || 0}" oninput="updateItem(${idx}, 'unitPrice', this.value)">
                    <input type="number" value="${it.gstPercent ?? 18}" oninput="updateItem(${idx}, 'gstPercent', this.value)" min="0" max="28">
                    <div class="font-mono font-bold text-right">${formatINR(it.total)}</div>
                    <button class="remove-btn" onclick="removeItem(${idx})">×</button>
                </div>
            `).join('');
        }
        recalcTotals();
    }
    
    function updateItem(idx, field, val) {
        if (['quantity', 'unitPrice', 'gstPercent'].includes(field)) {
            val = val === '' ? (field === 'gstPercent' ? 0 : 0) : Number(val);
        }
        items[idx][field] = val;
        const it = items[idx];
        const sub = (it.quantity || 0) * (it.unitPrice || 0);
        const gstP = Number(it.gstPercent) || 0;
        it.total = sub + (sub * gstP / 100);
        // Only re-render the total cell + grand totals, NOT the whole row (so input focus stays)
        updateRowTotal(idx);
        recalcTotals();
    }
    
    // Update just the total display of a row without re-rendering inputs
    function updateRowTotal(idx) {
        const rows = document.querySelectorAll('#itemsContainer .item-row');
        if (rows[idx]) {
            const totalCell = rows[idx].querySelector('.font-mono.font-bold.text-right');
            if (totalCell) totalCell.textContent = formatINR(items[idx].total);
        }
    }
    
    function addProduct(p) {
        items.push({
            productId: p._id,
            productName: p.productName,
            specifications: p.specifications || '',
            quantity: 1,
            unit: p.unit || 'Pcs',
            unitPrice: p.sellingPrice,
            gstPercent: p.gstPercent || 18,
            total: p.sellingPrice + (p.sellingPrice * (p.gstPercent || 18) / 100)
        });
        renderItems();
        showToast(`Added: ${p.productName}`, 'success');
    }
    
    function addCustomItem() {
        items.push({
            productName: '',
            specifications: '',
            warranty: '1 Year',
            quantity: 1,
            unit: 'Pcs',
            unitPrice: 0,
            gstPercent: 18,
            total: 0
        });
        renderItems();
    }
    
    function quickAdd(name, spec, warranty, price) {
        const gst = 18;
        items.push({
            productName: name,
            specifications: spec,
            warranty: warranty,
            quantity: 1,
            unit: 'Pcs',
            unitPrice: price,
            gstPercent: gst,
            total: price + (price * gst / 100)
        });
        renderItems();
        showToast(`Added: ${name}`, 'success');
    }
    
    function removeItem(idx) {
        items.splice(idx, 1);
        renderItems();
    }
    
    function setAllGst(pct) {
        if (items.length === 0) return showToast('Add items first', 'error');
        items.forEach(it => {
            it.gstPercent = pct;
            const sub = (it.quantity || 0) * (it.unitPrice || 0);
            it.total = sub + (sub * pct / 100);
        });
        renderItems();
        showToast(`All items set to ${pct}% GST`, 'success');
    }
    
    function recalcTotals() {
        let subtotal = 0, gst = 0;
        items.forEach(it => {
            const s = (it.quantity || 0) * (it.unitPrice || 0);
            subtotal += s;
            gst += s * (it.gstPercent || 0) / 100;
        });
        const install = Number(document.getElementById('q_install').value || 0);
        const disc = Number(document.getElementById('q_discount').value || 0);
        const grand = subtotal + gst + install - disc;
        document.getElementById('t_subtotal').textContent = formatINR(subtotal);
        document.getElementById('t_gst').textContent = formatINR(gst);
        document.getElementById('t_install').textContent = formatINR(install);
        document.getElementById('t_discount').textContent = '-' + formatINR(disc);
        document.getElementById('t_grand').textContent = formatINR(grand);
    }
    
    function filterProducts() {
        const q = document.getElementById('productSearch').value.toLowerCase();
        document.querySelectorAll('.product-item').forEach(el => {
            el.style.display = el.dataset.name.includes(q) ? 'block' : 'none';
        });
    }
    
    async function saveQuotation() {
        const data = {
            clientName: document.getElementById('q_client').value,
            clientCompany: document.getElementById('q_company').value,
            clientMobile: document.getElementById('q_mobile').value,
            clientEmail: document.getElementById('q_email').value,
            clientAddress: document.getElementById('q_address').value,
            projectType: document.getElementById('q_type').value,
            siteLocation: document.getElementById('q_site').value,
            items: items,
            installationCharges: Number(document.getElementById('q_install').value || 0),
            discount: Number(document.getElementById('q_discount').value || 0),
            validityDays: Number(document.getElementById('q_validity').value || 15),
            paymentTerms: document.getElementById('q_payment').value,
            warranty: document.getElementById('q_warranty').value,
            notes: document.getElementById('q_notes').value,
            status: document.getElementById('q_status').value
        };
        
        if (!data.clientName) return showToast('Client name required', 'error');
        if (items.length === 0) return showToast('Add at least one item', 'error');
        
        const url = QUOTATION_ID ? `/api/quotations/${QUOTATION_ID}` : '/api/quotations';
        const method = QUOTATION_ID ? 'PUT' : 'POST';
        const res = await api(url, { method, body: JSON.stringify(data) });
        
        if (res.success) {
            showToast('Quotation saved!', 'success');
            setTimeout(() => {
                if (!QUOTATION_ID) location.href = `/cctv/quotation/${res.quotation._id}/edit`;
                else location.reload();
            }, 500);
        }
    }
    
    // === CUSTOMER AUTO-FILL ===
    let custSearchTimer = null;
    
    function searchCustomer(q) {
        clearTimeout(custSearchTimer);
        const box = document.getElementById('custSuggestions');
        
        if (!q || q.trim().length < 3) {
            box.style.display = 'none';
            return;
        }
        
        custSearchTimer = setTimeout(async () => {
            try {
                const res = await fetch('/api/customers/lookup?q=' + encodeURIComponent(q.trim()));
                const data = await res.json();
                const list = data.suggestions || [];
                
                if (list.length === 0) {
                    box.innerHTML = '<div style="padding: 14px; text-align: center; color: #94a3b8; font-size: 13px;">No matching customer found.<br><span style="font-size:11px;">Fill details manually below ⬇️</span></div>';
                    box.style.display = 'block';
                    return;
                }
                
                box.innerHTML = list.map(c => `
                    <div onclick='fillCustomer(${JSON.stringify(c).replace(/'/g, "&#39;")})' 
                        style="padding: 10px 14px; border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: background 0.15s;"
                        onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background='white'">
                        <div style="font-weight: 700; font-size: 13px; color: #0f172a;">${c.name}${c.companyName ? ' · ' + c.companyName : ''}</div>
                        <div style="font-size: 11px; color: #64748b; margin-top: 2px;">
                            📞 ${c.mobile}${(c.primaryAddress || c.location) ? ' · 📍 ' + (c.primaryAddress || c.location).slice(0, 40) : ''}
                        </div>
                        ${c.totalServices ? `<div style="font-size: 10px; color: #16a34a; margin-top: 2px;">✓ ${c.totalServices} past services · ₹${(c.totalRevenue||0).toLocaleString('en-IN')} revenue</div>` : ''}
                    </div>
                `).join('');
                box.style.display = 'block';
            } catch (e) {
                box.style.display = 'none';
            }
        }, 300);
    }
    
    function fillCustomer(c) {
        document.getElementById('q_client').value = c.name || '';
        document.getElementById('q_company').value = c.companyName || '';
        document.getElementById('q_mobile').value = c.mobile || '';
        document.getElementById('q_email').value = c.email || '';
        const fullAddr = c.primaryAddress || c.location || '';
        document.getElementById('q_address').value = fullAddr;
        // Site location: use city/location or address
        const siteEl = document.getElementById('q_site');
        if (siteEl && !siteEl.value) siteEl.value = c.location || fullAddr || '';
        
        document.getElementById('custSuggestions').style.display = 'none';
        document.getElementById('custSearch').value = c.name + ' (' + c.mobile + ')';
        showToast('✓ Customer details filled: ' + c.name, 'success');
    }
    
    // Close suggestions when clicking outside
    document.addEventListener('click', (e) => {
        const search = document.getElementById('custSearch');
        const box = document.getElementById('custSuggestions');
        if (search && box && !search.contains(e.target) && !box.contains(e.target)) {
            box.style.display = 'none';
        }
    });
    
    renderItems();
    
    // Pre-fill customer if coming from Customer 360 page
    <% if (typeof prefillCustomer !== 'undefined' && prefillCustomer) { %>
    (function() {
        const pc = <%- JSON.stringify(prefillCustomer) %>;
        const setV = (id, v) => { const el = document.getElementById(id); if (el && v) el.value = v; };
        setV('q_client', pc.name);
        setV('q_company', pc.companyName);
        setV('q_mobile', pc.mobile);
        setV('q_email', pc.email);
        setV('q_address', pc.primaryAddress || pc.location);
        setV('q_site', pc.location || pc.primaryAddress);
        showToast('Customer details pre-filled: ' + pc.name, 'success');
    })();
    <% } %>
    
    // === PAYMENT RECORDING ===
    function openPaymentModal() { openModal('paymentModal'); }
    
    async function savePayment() {
        const amount = Number(document.getElementById('pm_amount').value) || 0;
        if (amount <= 0) return showToast('Enter valid amount', 'error');
        const data = {
            amount,
            date: document.getElementById('pm_date').value,
            mode: document.getElementById('pm_mode').value,
            type: document.getElementById('pm_type').value,
            reference: document.getElementById('pm_ref').value
        };
        const res = await api(`/api/quotations/${QUOTATION_ID}/payment`, { method: 'POST', body: JSON.stringify(data) });
        if (res.success) {
            showToast(`✓ Payment recorded! Balance: ₹${res.balanceDue.toLocaleString('en-IN')}`, 'success');
            setTimeout(() => location.reload(), 700);
        } else {
            showToast(res.error || 'Failed', 'error');
        }
    }
    
    // === LIFECYCLE DATES ===
    function openLifecycleModal() { openModal('lifecycleModal'); }
    
    async function saveLifecycle() {
        const data = {
            orderReceivedDate: document.getElementById('lc_order').value || null,
            expectedDeliveryDate: document.getElementById('lc_expected').value || null,
            actualDeliveryDate: document.getElementById('lc_delivered').value || null,
            installationDate: document.getElementById('lc_install').value || null,
            installationStatus: document.getElementById('lc_installStatus').value
        };
        const res = await api(`/api/quotations/${QUOTATION_ID}/lifecycle`, { method: 'POST', body: JSON.stringify(data) });
        if (res.success) {
            showToast('✓ Order dates updated', 'success');
            setTimeout(() => location.reload(), 700);
        }
    }
    
    // === VENDOR PROCUREMENT ===
    async function openVendorModal() {
        openModal('vendorModal');
        try {
            const res = await fetch('/api/vendors-list');
            const data = await res.json();
            if (data.success) {
                document.getElementById('vendorList').innerHTML = data.vendors.map(v => `<option value="${v.vendorName}">`).join('');
            }
        } catch (e) {}
        calcVendorTotal();
    }
    
    function calcVendorTotal() {
        const qty = Number(document.getElementById('v_qty').value) || 0;
        const price = Number(document.getElementById('v_price').value) || 0;
        const delivery = Number(document.getElementById('v_delivery').value) || 0;
        document.getElementById('v_total').textContent = '₹' + ((qty * price) + delivery).toLocaleString('en-IN');
    }
    
    async function saveVendor() {
        const data = {
            vendorName: document.getElementById('v_name').value,
            productName: document.getElementById('v_product').value,
            quantity: Number(document.getElementById('v_qty').value) || 1,
            vendorPrice: Number(document.getElementById('v_price').value) || 0,
            deliveryCharges: Number(document.getElementById('v_delivery').value) || 0,
            expectedDelivery: document.getElementById('v_expected').value || null,
            notes: document.getElementById('v_notes').value
        };
        if (!data.vendorName || !data.productName) return showToast('Vendor name & product required', 'error');
        const res = await api(`/api/quotations/${QUOTATION_ID}/vendor`, { method: 'POST', body: JSON.stringify(data) });
        if (res.success) { showToast('Vendor item added', 'success'); setTimeout(() => location.reload(), 500); }
    }
    
    async function payVendor(vi, maxDue) {
        const amount = prompt('Payment to vendor (₹). Due: ₹' + maxDue.toLocaleString('en-IN'), maxDue);
        if (!amount || Number(amount) <= 0) return;
        const res = await api(`/api/quotations/${QUOTATION_ID}/vendor/${vi}`, { method: 'PUT', body: JSON.stringify({ addPayment: Number(amount) }) });
        if (res.success) { showToast('Vendor payment recorded', 'success'); setTimeout(() => location.reload(), 500); }
    }
    
    async function updateVendorDelivery(vi, status) {
        const res = await api(`/api/quotations/${QUOTATION_ID}/vendor/${vi}`, { method: 'PUT', body: JSON.stringify({ deliveryStatus: status }) });
        if (res.success) showToast('Delivery: ' + status, 'success');
    }
    
    async function deleteVendor(vi) {
        if (!confirm('Remove this vendor item?')) return;
        const res = await api(`/api/quotations/${QUOTATION_ID}/vendor/${vi}`, { method: 'DELETE' });
        if (res.success) { showToast('Removed', 'success'); setTimeout(() => location.reload(), 500); }
    }
</script>
</body>
</html>
