<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Smart Vendor Compare — Searvator CRM</title>
    <link rel="stylesheet" href="/css/main.css">
    <%- include('partials/mobile-head') %>
    <style>
        .vendor-card {
            background: white;
            border: 2px solid var(--border);
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 12px;
            transition: all 0.2s;
        }
        .vendor-card.best { border-color: #10b981; background: linear-gradient(135deg, #f0fdf4, #ffffff); }
        .vendor-card.cheapest { border-color: #f59e0b; background: linear-gradient(135deg, #fffbeb, #ffffff); }
        .vendor-card.most-bought { border-color: #6366f1; }
        .vendor-tag {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            margin-right: 4px;
        }
        .tag-best { background: #d1fae5; color: #065f46; }
        .tag-cheapest { background: #fef3c7; color: #92400e; }
        .tag-most-bought { background: #e0e7ff; color: #3730a3; }
    </style>
</head>
<body>
<div class="app-layout">
    <%- include('partials/sidebar', { user: user, activePage: 'vendors' }) %>
    
    <main class="main-content">
        <div style="margin-bottom: 12px;">
            <a href="/vendors" style="color: var(--text-3); text-decoration: none; font-size: 13px;">← Back to Vendors</a>
        </div>
        
        <div class="page-header">
            <div>
                <h1 class="page-title">🧠 Smart Vendor Compare</h1>
                <p class="page-subtitle">Search any product · See best vendor based on price + history</p>
            </div>
        </div>
        
        <div class="card">
            <div class="card-body">
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="productSearch" placeholder="Type product name (e.g. CCTV camera, RAM, monitor)..." value="<%= query %>" style="flex: 1;">
                    <button class="btn btn-primary" onclick="search()">🔍 Search</button>
                </div>
                <div style="font-size: 11px; color: var(--text-3); margin-top: 6px;">
                    💡 System will analyze all vendor bills and rank vendors by: cheapest price · payment reliability · purchase history
                </div>
            </div>
        </div>
        
        <div id="results"></div>
    </main>
</div>

<script src="/js/common.js"></script>
<script>
async function search() {
    const q = document.getElementById('productSearch').value.trim();
    if (!q) return showToast('Type a product name', 'error');
    
    const container = document.getElementById('results');
    container.innerHTML = '<div class="card"><div class="card-body" style="text-align:center;padding:30px;">⏳ Searching across all vendor bills...</div></div>';
    
    const res = await fetch('/api/vendors/suggest?product=' + encodeURIComponent(q));
    const data = await res.json();
    
    if (!data.suggestions || data.suggestions.length === 0) {
        container.innerHTML = '<div class="card"><div class="card-body" style="text-align:center;padding:50px;color:var(--text-3);"><div style="font-size:32px;">🔍</div><p>No vendor found selling "' + q + '". Try different keywords.</p></div></div>';
        return;
    }
    
    let html = '<div class="card"><div class="card-header"><div class="card-title">' + data.suggestions.length + ' Vendor(s) Found for "' + q + '"</div></div><div class="card-body">';
    
    data.suggestions.forEach((v, idx) => {
        let cardClass = 'vendor-card';
        const tags = [];
        if (v._best) { cardClass += ' best'; tags.push('<span class="vendor-tag tag-best">⭐ Best Overall</span>'); }
        if (v._cheapest) { cardClass += ' cheapest'; tags.push('<span class="vendor-tag tag-cheapest">💰 Cheapest</span>'); }
        if (v._mostBought) { cardClass += ' most-bought'; tags.push('<span class="vendor-tag tag-most-bought">🔄 Most Purchased</span>'); }
        
        html += `
            <div class="${cardClass}">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px;">
                    <div>
                        <div style="font-weight: 800; font-size: 16px;">#${idx+1} <a href="/vendors/${v.vendorId}" style="color: var(--text); text-decoration: none;">${v.vendorName}</a></div>
                        <div style="font-size: 12px; color: var(--text-3); margin-top: 2px;">${v.contact || ''} · 📞 ${v.mobile || ''} · ${v.category}</div>
                        <div style="margin-top: 6px;">${tags.join('')}</div>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">Score</div>
                        <div style="font-size: 24px; font-weight: 800; color: var(--primary);">${v.score}</div>
                    </div>
                </div>
                
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 10px; background: var(--surface-2); border-radius: 8px; margin-bottom: 10px;">
                    <div>
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">Latest Price</div>
                        <div style="font-weight: 800; font-size: 16px; color: ${v._cheapest ? 'var(--success)' : 'var(--text)'};">₹${(v.latestPrice||0).toLocaleString('en-IN')}</div>
                    </div>
                    <div>
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">We Sell At</div>
                        <div style="font-weight: 700; font-size: 14px;">₹${(v.sellingPrice||0).toLocaleString('en-IN')}</div>
                    </div>
                    <div>
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">GST</div>
                        <div style="font-weight: 700; font-size: 14px;">${v.gstPercent}%</div>
                    </div>
                    <div>
                        <div style="font-size: 10px; color: var(--text-3); text-transform: uppercase;">Warranty</div>
                        <div style="font-weight: 700; font-size: 13px;">${v.warranty || '-'}</div>
                    </div>
                </div>
                
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; font-size: 12px;">
                    <div>
                        <div style="font-size: 10px; color: var(--text-3);">Times Bought</div>
                        <div style="font-weight: 700;">${v.totalPurchases}</div>
                    </div>
                    <div>
                        <div style="font-size: 10px; color: var(--text-3);">Total Billed</div>
                        <div style="font-weight: 700;">₹${v.totalBilled.toLocaleString('en-IN')}</div>
                    </div>
                    <div>
                        <div style="font-size: 10px; color: var(--text-3);">Paid</div>
                        <div style="font-weight: 700; color: var(--success);">₹${v.totalPaid.toLocaleString('en-IN')}</div>
                    </div>
                    <div>
                        <div style="font-size: 10px; color: var(--text-3);">Credit Used</div>
                        <div style="font-weight: 700; color: ${v.pendingPayment > 0 ? 'var(--danger)' : 'var(--success)'};">₹${v.pendingPayment.toLocaleString('en-IN')}</div>
                    </div>
                </div>
                
                <div style="margin-top: 10px; font-size: 11px; color: var(--text-3);">
                    Last purchased: ${new Date(v.lastPurchaseDate).toLocaleDateString('en-IN')} (Bill #${v.lastBillNumber})
                </div>
            </div>
        `;
    });
    
    html += '</div></div>';
    container.innerHTML = html;
}

// Auto-search if query in URL
<% if (query) { %>
window.addEventListener('DOMContentLoaded', () => search());
<% } %>
</script>
</body>
</html>
