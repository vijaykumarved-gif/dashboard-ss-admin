<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Vendors — Searvator CRM</title>
    <link rel="stylesheet" href="/css/main.css">
    <%- include('partials/mobile-head') %>
</head>
<body>
<div class="app-layout">
    <%- include('partials/sidebar', { user: user, activePage: 'vendors' }) %>
    
    <main class="main-content">
        <div class="page-header">
            <div>
                <h1 class="page-title">Vendor Management</h1>
                <p class="page-subtitle">Suppliers, bills, payments & purchase tracking</p>
            </div>
            <div class="flex gap-2">
                <a href="/vendor-compare" class="btn btn-secondary">🧠 Smart Compare</a>
                <button class="btn btn-primary" onclick="openModal('newVendorModal')">+ Add Vendor</button>
            </div>
        </div>
        
        <div class="stats-grid">
            <div class="stat-card blue">
                <div class="stat-label">Total Vendors</div>
                <div class="stat-value"><%= stats.totalVendors %></div>
                <div class="stat-meta">Active suppliers</div>
            </div>
            <div class="stat-card purple">
                <div class="stat-label">Total Purchased</div>
                <div class="stat-value"><%= formatINR(stats.totalPurchased) %></div>
                <div class="stat-meta">All-time purchase value</div>
            </div>
            <div class="stat-card green">
                <div class="stat-label">Total Paid</div>
                <div class="stat-value" style="color: var(--success)"><%= formatINR(stats.totalPaid) %></div>
                <div class="stat-meta">Cleared payments</div>
            </div>
            <div class="stat-card red">
                <div class="stat-label">Pending Payment</div>
                <div class="stat-value" style="color: var(--danger)"><%= formatINR(stats.totalPending) %></div>
                <div class="stat-meta">To be paid to vendors</div>
            </div>
        </div>
        
        <div class="card">
            <div class="card-header">
                <div class="card-title">All Vendors</div>
            </div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Vendor</th>
                            <th>Contact</th>
                            <th>Category</th>
                            <th>Bills</th>
                            <th>Purchased</th>
                            <th>Paid</th>
                            <th>Pending</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (vendors.length === 0) { %>
                            <tr><td colspan="8" class="text-center" style="padding: 60px; color: var(--text-3);">
                                <div style="font-size: 32px; margin-bottom: 8px;">🏢</div>
                                No vendors yet. Click <strong>+ Add Vendor</strong> to start.
                            </td></tr>
                        <% } else { vendors.forEach(v => {
                            const billsTotal = (v.bills || []).reduce((s, b) => s + (b.grandTotal || 0), 0);
                            const paid = (v.payments || []).reduce((s, p) => s + (p.amount || 0), 0);
                            const pending = Math.max(0, billsTotal - paid);
                            const sc = v.status === 'Active' ? 'success' : v.status === 'Blacklisted' ? 'danger' : 'neutral';
                        %>
                            <tr style="cursor: pointer;" onclick="location.href='/vendors/<%= v._id %>'">
                                <td>
                                    <div class="font-bold"><%= v.vendorName %></div>
                                    <% if (v.gstNumber) { %><div class="text-muted" style="font-size: 11px;">GST: <%= v.gstNumber %></div><% } %>
                                </td>
                                <td>
                                    <div><%= v.contactPerson %></div>
                                    <div class="text-muted" style="font-size: 11px;"><%= v.mobile %></div>
                                </td>
                                <td><span class="badge info"><%= v.category %></span></td>
                                <td class="font-mono"><%= v.bills.length %></td>
                                <td class="font-mono font-bold"><%= formatINR(billsTotal) %></td>
                                <td class="font-mono text-success"><%= formatINR(paid) %></td>
                                <td class="font-mono text-danger"><%= formatINR(pending) %></td>
                                <td><span class="badge <%= sc %>"><%= v.status %></span></td>
                            </tr>
                        <% }) } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<div class="modal-overlay" id="newVendorModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">Add New Vendor</div>
            <button class="modal-close" onclick="closeModal('newVendorModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="form-grid">
                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Vendor Name *</label>
                    <input type="text" id="v_name" placeholder="ABC Distributors Pvt Ltd">
                </div>
                <div class="form-group">
                    <label class="form-label">Contact Person</label>
                    <input type="text" id="v_person">
                </div>
                <div class="form-group">
                    <label class="form-label">Mobile</label>
                    <input type="text" id="v_mobile">
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" id="v_email">
                </div>
                <div class="form-group">
                    <label class="form-label">Category</label>
                    <select id="v_cat">
                        <option>Mixed</option><option>CCTV</option><option>Hardware</option>
                        <option>Software</option><option>Biometric</option><option>Tools</option>
                    </select>
                </div>
                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Address</label>
                    <textarea id="v_addr" rows="2"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">GST Number</label>
                    <input type="text" id="v_gst">
                </div>
                <div class="form-group">
                    <label class="form-label">PAN</label>
                    <input type="text" id="v_pan">
                </div>
                <div class="form-group">
                    <label class="form-label">Bank Name</label>
                    <input type="text" id="v_bank">
                </div>
                <div class="form-group">
                    <label class="form-label">A/C Number</label>
                    <input type="text" id="v_acc">
                </div>
                <div class="form-group">
                    <label class="form-label">IFSC</label>
                    <input type="text" id="v_ifsc">
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('newVendorModal')">Cancel</button>
            <button class="btn btn-primary" onclick="createVendor()">Save Vendor</button>
        </div>
    </div>
</div>

<script src="/js/common.js"></script>
<script>
    async function createVendor() {
        const data = {
            vendorName: document.getElementById('v_name').value,
            contactPerson: document.getElementById('v_person').value,
            mobile: document.getElementById('v_mobile').value,
            email: document.getElementById('v_email').value,
            address: document.getElementById('v_addr').value,
            category: document.getElementById('v_cat').value,
            gstNumber: document.getElementById('v_gst').value,
            panNumber: document.getElementById('v_pan').value,
            bankName: document.getElementById('v_bank').value,
            accountNumber: document.getElementById('v_acc').value,
            ifscCode: document.getElementById('v_ifsc').value
        };
        if (!data.vendorName) return showToast('Vendor name required', 'error');
        const res = await api('/api/vendors', { method: 'POST', body: JSON.stringify(data) });
        if (res.success) { showToast('Vendor added', 'success'); setTimeout(() => location.href = '/vendors/' + res.vendor._id, 500); }
    }
</script>
</body>
</html>
